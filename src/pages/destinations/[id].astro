---
import DestinationLayout from '../../layouts/DestinationLayout.astro';
import destinations from '../../data/destinations.json';
import hubCities from '../../data/hubCities.json';
import { pickJRService, jrServiceUrl, jrServiceLabel } from '../../../scripts/jrServiceMap.js';
import { skyscannerUrl } from '../../../scripts/airportMap.js';
import { jalanKeywordSearchTarget } from '../../../scripts/jalanUrl.js';
import fs from 'fs';
import path from 'path';

export function getStaticPaths() {
  return destinations.map(dest => ({
    params: { id: dest.id },
    props: { dest }
  }));
}

const { dest } = Astro.props;

const articlePath = path.join(process.cwd(), 'src/data/articles', `${dest.id}.json`);
const article = fs.existsSync(articlePath)
  ? JSON.parse(fs.readFileSync(articlePath, 'utf8'))
  : null;

// 画像判定: 1) public/images/{id}/main.jpg フォルダ形式 2) public/images/{id}.jpg 旧形式 3) destinations.json の images[0] が外部URL
const hasMainImg = fs.existsSync(path.join(process.cwd(), 'public/images', dest.id, 'main.jpg'));
const hasSingleImg = fs.existsSync(path.join(process.cwd(), 'public/images', `${dest.id}.jpg`));
const firstImageField = ((dest as any).images && (dest as any).images[0]) || null;
const hasImage = hasMainImg || hasSingleImg || (firstImageField && !firstImageField.startsWith('/images/'));
const localImageUrl = hasMainImg
  ? `/images/${dest.id}/main.jpg`
  : hasSingleImg
    ? `/images/${dest.id}.jpg`
    : (firstImageField && !firstImageField.startsWith('/images/') ? firstImageField : null);
const unsplashUrl    = !hasImage ? ((dest as any).unsplashUrl ?? null) : null;
const imageUrl       = localImageUrl ?? unsplashUrl;
// CC帰属(imageCredit: { author, license, url }) — author か license があれば表示
const ic = (dest as any).imageCredit;
const heroCredit = (localImageUrl && ic && (ic.author || ic.license)) ? ic : null;
const unsplashCredit    = unsplashUrl ? ((dest as any).unsplashCredit ?? null) : null;
const unsplashCreditUrl = unsplashUrl ? ((dest as any).unsplashCreditUrl ?? null) : null;
const unsplashPhotoUrl  = unsplashUrl ? ((dest as any).unsplashPhotoUrl ?? null) : null;

const seoTitle = `【${dest.name}】おすすめ観光スポット${dest.spots?.length || 3}選｜${dest.prefecture}の旅`;
// meta description は 120字前後に整形する。dest.description（200〜300字）を
// そのまま使うと検索結果で途中切りされるため、文境界（。）で 120字以内へ丸める。
function toMetaDescription(text: string): string {
  if (!text) return '';
  if (text.length <= 130) return text;
  const head = text.slice(0, 130);
  const cut = head.lastIndexOf('。');
  return cut >= 60 ? head.slice(0, cut + 1) : head.slice(0, 118) + '…';
}
const description =
  article?.lead?.slice(0, 120)
  || toMetaDescription(dest.description)
  || `${dest.name}（${dest.prefecture}）への行き方・宿・観光スポット情報。`;

const CITY_NAMES: Record<string, string> = {
  tokyo: '東京', osaka: '大阪', nagoya: '名古屋', fukuoka: '福岡',
  takamatsu: '高松', sapporo: '札幌', sendai: '仙台', hiroshima: '広島',
  naha: '那覇', kanazawa: '金沢', gifu: '岐阜', mito: '水戸',
  maebashi: '前橋', takasaki: '高崎', hamamatsu: '浜松', kofu: '甲府',
  shingu: '新宮', tanabe: '田辺', shirahama: '白浜', kushimoto: '串本',
  tottori: '鳥取', shimonoseki: '下関', saga: '佐賀', oita: '大分', beppu: '別府',
  akita: '秋田', aomori: '青森', fukushima: '福島', fukuyama: '福山',
  hachinohe: '八戸', hakodate: '函館', himeji: '姫路', ishigaki: '石垣',
  kitakyushu: '北九州', kitami: '北見', kurashiki: '倉敷', kushiro: '釧路',
  miyako: '宮古', niigata: '新潟', obihiro: '帯広', wakayama: '和歌山',
  yamagata: '山形', yamaguchi: '山口',
};


// city(日本語)→prefecture map (JR予約サービス判定用)
const CITY_TO_PREF: Record<string, string> = {
  '札幌':'北海道','函館':'北海道','旭川':'北海道','釧路':'北海道','帯広':'北海道','北見':'北海道','稚内':'北海道',
  '青森':'青森県','八戸':'青森県','盛岡':'岩手県','秋田':'秋田県','山形':'山形県','仙台':'宮城県','福島':'福島県',
  '水戸':'茨城県','宇都宮':'栃木県','前橋':'群馬県','高崎':'群馬県','大宮':'埼玉県','千葉':'千葉県',
  '東京':'東京都','横浜':'神奈川県','新潟':'新潟県','金沢':'石川県','富山':'富山県','福井':'福井県',
  '甲府':'山梨県','長野':'長野県','松本':'長野県','岐阜':'岐阜県','名古屋':'愛知県','浜松':'静岡県','静岡':'静岡県',
  '京都':'京都府','大阪':'大阪府','神戸':'兵庫県','姫路':'兵庫県','尼崎':'兵庫県','高槻':'大阪府','泉佐野':'大阪府',
  '津':'三重県','大津':'滋賀県','奈良':'奈良県','和歌山':'和歌山県','新宮':'和歌山県','田辺':'和歌山県','白浜':'和歌山県','串本':'和歌山県',
  '鳥取':'鳥取県','松江':'島根県','岡山':'岡山県','倉敷':'岡山県','広島':'広島県','福山':'広島県','下関':'山口県','山口':'山口県','北九州':'福岡県',
  '高松':'香川県','松山':'愛媛県','高知':'高知県','徳島':'徳島県',
  '福岡':'福岡県','佐賀':'佐賀県','長崎':'長崎県','熊本':'熊本県','大分':'大分県','別府':'大分県','宮崎':'宮崎県','鹿児島':'鹿児島県',
  '那覇':'沖縄県','宮古':'沖縄県','石垣':'沖縄県',
};

// 出発都市を「全都市常時表示」: travelTimeデータの有無に関わらず主要都市は常に選択肢に出す
// 主要都市（札幌・仙台・東京・横浜・名古屋・京都・大阪・神戸・広島・松山・高松・福岡・長崎・熊本・鹿児島・那覇 等）を網羅
const ALL_DEPARTURE_CITIES_JP = [
  '札幌','函館','旭川','釧路','帯広','北見',
  '青森','八戸','盛岡','秋田','山形','仙台','福島','水戸',
  '前橋','高崎','東京','横浜','新潟','金沢','富山','甲府','長野','岐阜',
  '名古屋','浜松','京都','大阪','神戸','姫路','和歌山','新宮','田辺','白浜','串本',
  '鳥取','岡山','倉敷','広島','福山','下関','山口','北九州',
  '高松','松山','高知','徳島',
  '福岡','佐賀','長崎','熊本','大分','別府','宮崎','鹿児島','那覇','宮古','石垣',
];
// travelTimeデータがある(0<v<=240) cityのみ block 生成（変換: cityキー→日本語名）
const PRIORITY_CITIES = ['tokyo','osaka','nagoya','fukuoka','sapporo','sendai','hiroshima','takamatsu','naha','kanazawa'];
const travelTimes = Object.entries(dest.travelTime || {})
  .filter(([_, v]) => v && (v as number) > 0 && (v as number) <= 480)
  .sort(([a, va], [b, vb]) => {
    const ai = PRIORITY_CITIES.indexOf(a);
    const bi = PRIORITY_CITIES.indexOf(b);
    if (ai >= 0 && bi >= 0) return ai - bi;
    if (ai >= 0) return -1;
    if (bi >= 0) return 1;
    return (va as number) - (vb as number);
  })
  .map(([city, min]) => ({
    city: CITY_NAMES[city] || city,
    min
  }));
// travelTimeデータがある city の Set（select 表示判定用）
const travelTimeCitySet = new Set(travelTimes.map(t => t.city));

const STEP_TYPE_LABEL: Record<string, string> = {
  rail: '鉄道', ferry: '船', flight: '航空', bus: 'バス', car: '車', local: '移動',
};

const hubName: string = (dest as any).hubName || '';
const stayAllowed: string[] = (dest as any).stayAllowed || [];
const isDaytripOnly = stayAllowed.length > 0 && !stayAllowed.includes('1night');
const railNote: string = (dest as any).railNote || '';
const isBusOnly = railNote.includes('バス') && !!(dest as any).hub;

const hotelLinks = (dest as any).hotelLinks as { rakuten: string; jalan: string } | null | undefined;

// Fix1: Rakuten URLをキーワードのみで再生成（余分な "香川県 宿" 等を除去）
const RAKUTEN_AFF = 'https://hb.afl.rakuten.co.jp/hgc/5113ee4b.8662cfc5.5113ee4c.119de89a/';
const JALAN_AFF   = 'https://ck.jp.ap.valuecommerce.com/servlet/referral?sid=3764408&pid=892559858&vc_url=';

// 楽天のキーワード検索。yado/japan.html?f_query= は現在キーワードが効かず
// 「地図から探す」トップ相当に着地してしまうため、実際に検索結果が返る
// キーワード検索エンドポイント（楽天トラベル公式の検索フォーム送信先）を使う。
function buildRakutenUrl(keyword: string): string {
  const target = `https://kw.travel.rakuten.co.jp/keyword/Search.do?f_query=${encodeURIComponent(keyword)}`;
  return `${RAKUTEN_AFF}?pc=${encodeURIComponent(target)}`;
}
// じゃらんの宿キーワード検索はShift_JISエンコード必須(scripts/jalanUrl.js参照)。
function buildJalanUrl(keyword: string): string {
  return `${JALAN_AFF}${encodeURIComponent(jalanKeywordSearchTarget(keyword))}`;
}

// ソースデータの宿URLが素リンクでも、ビルド時に必ずアフィリエイトを付与する。
// 既にアフィリ形式のものはそのまま維持（キュレート済みの地域別ディープリンクを保持）。
function toRakutenAffiliate(url: string): string {
  if (!url) return url;
  if (url.startsWith('https://hb.afl.rakuten.co.jp/')) return url; // 既にアフィリ
  if (url.includes('rakuten.co.jp')) return `${RAKUTEN_AFF}?pc=${encodeURIComponent(url)}`;
  return url;
}
// 【2026-09-17】楽天の宿リンクはキーワード検索（kw.travel.rakuten.co.jp）だけを許可する。
// 楽天トラベルの AASA は /HOTEL/* や /yado/*/* をアプリの対象にしており、さらにアフィリの
// リダイレクタは宛先が travel.rakuten.co.jp だと必ず hb.afl.rakuten.co.jp/travel/…
// （これもアプリ対象）を経由させる。個別ページ・県トップ・エリアページはどれも
// リダイレクト途中で楽天トラベルアプリが起動する（scripts/auditRakutenAppLinks.mjs で実測）。
// キーワード検索の宛先だけはこの経路を通らないので、それ以外は宿名・地名の検索に置き換える。
// じゃらんの safeJalanUrl（2026-08-12）と同じ許可リスト方式。
function isRakutenSafeTarget(rawUrl: string): boolean {
  let inner = rawUrl;
  try {
    const u = new URL(rawUrl);
    if (u.hostname === 'hb.afl.rakuten.co.jp') inner = u.searchParams.get('pc') || '';
    return new URL(inner).hostname === 'kw.travel.rakuten.co.jp';
  } catch {
    return false;
  }
}
function safeRakutenUrl(rawUrl: string | null | undefined, keyword: string): string {
  if (rawUrl && isRakutenSafeTarget(rawUrl)) return toRakutenAffiliate(rawUrl);
  return buildRakutenUrl(keyword);
}
function toJalanAffiliate(url: string): string {
  if (!url) return url;
  if (url.startsWith('https://ck.jp.ap.valuecommerce.com/')) return url; // 既にアフィリ
  if (url.includes('jalan.net')) return `${JALAN_AFF}${encodeURIComponent(url)}`;
  return url;
}

// じゃらんアプリのUniversal Link発火を防ぐための「安全形式の許可リスト」。
// AASA対象外のURLでも、サーバーリダイレクト後の着地先がUL対象だとアプリが起動する
// （例: /140000/ → 301 → /ikisaki/map/kanagawa/ で発火・実機確認済み）。そのため
// ブラックリスト照合ではなく、全リダイレクトホップがUL対象外であることを実測確認
// できた形式だけを許可し、それ以外は全てキーワード検索URLへ差し替える。
// 実測(iPhone UA・scripts/checkJalanRedirects.mjs):
//   /uw/uwp2011/uww2011init.do?keyword= … 302→302→200 全ホップ安全(一意ヒットでも宿詳細へ飛ばない)
//   /activity/                          … 200直
//   /rentacar/                          … 200直
function isJalanSafeUrl(rawUrl: string): boolean {
  let u: URL;
  try { u = new URL(rawUrl); } catch { return false; }
  if (!/(^|\.)jalan\.net$/.test(u.hostname)) return false;
  const p = u.pathname;
  return p === '/uw/uwp2011/uww2011init.do' || p === '/activity/' || p === '/rentacar/' || p.startsWith('/rentacar/');
}
// VCラッパー(vc_url=...)の中身も含めて検査し、許可リスト外ならキーワード検索へ差替
function safeJalanUrl(rawUrl: string | null | undefined, keyword: string): string {
  if (!rawUrl) return buildJalanUrl(keyword);
  let inner = rawUrl;
  const m = rawUrl.match(/[?&]vc_url=([^&]+)/);
  if (m) { try { inner = decodeURIComponent(m[1]); } catch { /* noop */ } }
  if (inner.includes('jalan.net') && !isJalanSafeUrl(inner)) return buildJalanUrl(keyword);
  return toJalanAffiliate(rawUrl);
}

// 注目の宿（featured_stay）: 実在・送迎情報をWeb確認済みのキュレーション枠。
// rakutenUrl/jalanUrl 省略時は宿名での検索リンクにフォールバック（404リスク回避）。
const featuredStay = (dest as any).featured_stay || null;
const fsRakutenUrl = featuredStay
  ? safeRakutenUrl(featuredStay.rakutenUrl, featuredStay.name)
  : '';
const fsJalanUrl = featuredStay
  ? safeJalanUrl(featuredStay.jalanUrl, featuredStay.name)
  : '';
// 楽天・じゃらんに掲載の無い宿（電話予約のみの山小屋・秘湯宿など）。
// 宿名検索のボタンを出しても何もヒットせず、別の宿が出ることさえあるので、
// 公式サイトへのボタンだけを出す。otaListed を明示的に false にした宿に限る。
// 送迎の表示。データに書いてあることだけを出す（2026-09-17 再表示）。
//   shuttleInfo があればその文言 / hasShuttle:true で文言が無ければ「送迎あり」/
//   それ以外（hasShuttle:false だけ、または未設定）は何も出さない。
//   hasShuttle:false だけの行は「送迎なし」と断定できる根拠が無い古いデータが多いため。
const fsShuttleText: string = featuredStay
  ? (featuredStay.shuttleInfo || (featuredStay.hasShuttle === true ? '送迎あり' : ''))
  : '';
const fsOfficialOnly: boolean = !!(featuredStay
  && featuredStay.otaListed === false
  && typeof featuredStay.officialUrl === 'string'
  && /^https:\/\//.test(featuredStay.officialUrl));

const hotelKeyword = (dest as any).hotelSearch || dest.name;
const rakutenHotelUrl = safeRakutenUrl(hotelLinks?.rakuten, hotelKeyword);
const jalanHotelUrl = safeJalanUrl(hotelLinks?.jalan, hotelKeyword);

// 宿セクション: 現地泊・hub泊・prefecture fallbackの三段構え
const isIsland: boolean = !!(dest as any).isIsland || (dest as any).destType === 'island' || (dest as any).subType === 'island';
// 通常は hubCity を採用。hubCity が自分自身 (離島でよくある) なら hubName で代替
const _rawHubCity = (dest as any).hubCity;
const hubCityName: string = (_rawHubCity && _rawHubCity !== dest.name)
  ? _rawHubCity
  : ((hubName && hubName !== dest.name) ? hubName : '');
const hasOvernight = stayAllowed.includes('1night') || stayAllowed.includes('2night') || stayAllowed.includes('3night+');
const isOwnHub = hubCityName === dest.name;
// 現地宿ボタン表示 (hotelLinksあれば表示・daytrip専用でも近隣の宿提案として有用)
// hubHotelOnly: 渓谷・展望台等で現地宿が実質存在せず、宿リンクが県汎用トップに
// しか着地しないdestination。現地宿ボタンを出さずhub(拠点都市)宿へ一本化する。
const showLocalHotel = !!hotelLinks?.rakuten && !(dest as any).hubHotelOnly;
// hubに泊まる選択肢を必ず提供 (現地で泊まれても・hub != 自分なら提供)
const showHubHotel = !!hubCityName && !isOwnHub;

let hubRakutenUrl = '';
let hubJalanUrl   = '';
if (showHubHotel) {
  const hubDest = (destinations as any[]).find((d: any) => d.name === hubCityName && d.hotelLinks);
  if (hubDest) {
    const hubKeyword = hubDest.hotelSearch || hubDest.name;
    hubRakutenUrl = safeRakutenUrl(hubDest.hotelLinks.rakuten, hubKeyword);
    hubJalanUrl   = safeJalanUrl(hubDest.hotelLinks.jalan, hubCityName);
  } else {
    // 県トップ（/yado/{県}/）はアプリ起動の対象なので使わず、じゃらんと同じく都市名で検索する。
    hubRakutenUrl = buildRakutenUrl(hubCityName);
    hubJalanUrl   = buildJalanUrl(hubCityName);
  }
}

// prefecture 列は「長野県・岐阜県」のように県をまたぐ行がある（御嶽山・しまなみ海道・
// 白神山地・八ヶ岳の4件）。完全一致で扱うとこの4件がどの県にも属さない扱いになり、
// 「同県の他の旅先」が0件になったり県庁所在地フォールバックが効かなくなる。
// 区切り文字で分割して「どれか1県でも重なれば同県」とみなす。
function prefParts(pref: unknown): string[] {
  return String(pref ?? '')
    .split(/[・、,\/／]/)
    .map((x) => x.trim())
    .filter(Boolean);
}

/** a と b が1県でも共通していれば true（「長野県・岐阜県」と「長野県」は同県とみなす）。 */
function sharesPrefecture(a: unknown, b: unknown): boolean {
  const pa = prefParts(a);
  const pb = prefParts(b);
  if (pa.length === 0 || pb.length === 0) return false;
  return pa.some((x) => pb.includes(x));
}

// fallback: 現地もhubも宿が出せない場合 → 県庁所在地
const PREF_CAPITAL: Record<string, string> = {
  '北海道':'札幌','青森県':'青森','岩手県':'盛岡','宮城県':'仙台','秋田県':'秋田','山形県':'山形','福島県':'福島',
  '茨城県':'水戸','栃木県':'宇都宮','群馬県':'前橋','埼玉県':'さいたま','千葉県':'千葉','東京都':'東京','神奈川県':'横浜',
  '新潟県':'新潟','富山県':'富山','石川県':'金沢','福井県':'福井','山梨県':'甲府','長野県':'長野','岐阜県':'岐阜','静岡県':'静岡','愛知県':'名古屋',
  '三重県':'津','滋賀県':'大津','京都府':'京都','大阪府':'大阪','兵庫県':'神戸','奈良県':'奈良','和歌山県':'和歌山',
  '鳥取県':'鳥取','島根県':'松江','岡山県':'岡山','広島県':'広島','山口県':'山口',
  '徳島県':'徳島','香川県':'高松','愛媛県':'松山','高知県':'高知',
  '福岡県':'福岡','佐賀県':'佐賀','長崎県':'長崎','熊本県':'熊本','大分県':'大分','宮崎県':'宮崎','鹿児島県':'鹿児島','沖縄県':'那覇',
};
const showPrefHotel = !showLocalHotel && !showHubHotel;
let prefCapital = '';
let prefRakutenUrl = '';
let prefJalanUrl   = '';
// 連結表記でも引けるよう、最初に辞書に載っている県の県庁所在地を使う。
const destPrefKey = prefParts(dest.prefecture).find((x) => PREF_CAPITAL[x]) ?? '';
if (showPrefHotel && destPrefKey) {
  prefCapital = PREF_CAPITAL[destPrefKey];
  if (prefCapital !== dest.name) {
    prefRakutenUrl = buildRakutenUrl(prefCapital);
    prefJalanUrl   = buildJalanUrl(prefCapital);
  }
}

// 後方互換用
const showDualHotel = showLocalHotel && showHubHotel;
const hotelSectionTitle = `${dest.name}の宿を探す`;
const daytripNote = isDaytripOnly && hubCityName && !isOwnHub
  ? `${dest.name}へは${hubCityName}から日帰りがおすすめ`
  : '';

const STAY_DESC: Record<string, string> = {
  onsen:    '温泉旅館が中心。1泊2食プランがおすすめ。',
  city:     'ビジネスホテルから旅館まで幅広い選択肢。',
  island:   '宿数が少ないため早めの予約を。',
  mountain: '近隣の温泉地や市街地に宿が集まる。',
  sight:    '近隣の温泉地や市街地に宿が集まる。',
  remote:   '近隣の温泉地や市街地に宿が集まる。',
  peninsula:'近隣エリアに宿が集まる。',
};
const stayNote: string = article?.bestStay || STAY_DESC[(dest as any).destType] || '';

// ── Googleマップのリンク生成 ──────────────────────────────
// 「湯の鶴温泉 熊本県」のようなテキストで maps/search に飛ばすと、
// Google側が宿泊検索と解釈して周辺ホテルの価格ピンだらけの画面になり、
// 肝心の目的地がどこか分からなくなる。座標は全destinationに入っているので、
// 座標が使えるときは緯度経度で指定し、ピンとルートが一点に定まるようにする。
const _lat = typeof (dest as any).lat === 'number' ? (dest as any).lat : null;
const _lng = typeof (dest as any).lng === 'number' ? (dest as any).lng : null;
const hasCoord: boolean = _lat !== null && _lng !== null;
const coordQ = hasCoord ? `${_lat},${_lng}` : '';
// 目的地そのものを地図に出す（ピン1本）。座標が無ければ従来のテキスト検索へ。
const gmapPlaceUrl: string = hasCoord
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(coordQ)}`
  : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${dest.name} ${(dest as any).prefecture || ''}`.trim())}`;
// 出発地→目的地の経路。destination を座標にすると宿泊検索に化けない。
const gmapDirUrl = (from: string, driving = false): string => {
  const to = hasCoord ? coordQ : `${dest.name} ${(dest as any).prefecture || ''}`.trim();
  return `https://www.google.com/maps/dir/?api=1&origin=${encodeURIComponent(from)}`
    + `&destination=${encodeURIComponent(to)}${driving ? '&travelmode=driving' : ''}`;
};
// spotは個別の座標を持たないので検索は名前のまま。ただし目的地の座標を中心に
// 添えて、同名の別の場所を全国から拾わないようにする。
const gmapSpotUrl = (spot: string): string => hasCoord
  ? `https://www.google.com/maps/search/${encodeURIComponent(spot)}/@${_lat},${_lng},14z`
  : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${spot} ${dest.name}`)}`;

// 地上経路で行けるかを判定 (false → Yahoo乗換ボタン非表示)
// gateways.airport は「その空港も使える」という参考情報であって、
// 鉄道やバスで行けないことを意味しない。判定に入れていたせいで、
// 空港を1つ書いただけのdestinationで乗換案内ボタンが消えていた（35件で実測0%）。
// 空路の選択肢があっても地上の経路案内は別途出してよいので、airport は見ない。
// ferry と access.steps の空路/航路、離島は従来どおり除外する。
const _accessStepTypes = new Set(((dest as any).access?.steps || []).map((s: any) => s.type));
const _hasNonRailStep = _accessStepTypes.has('flight') || _accessStepTypes.has('ferry');
const _hasFerryGateway = ((dest as any).gateways?.ferry || []).length > 0;
const isRailReachable: boolean = !isIsland && !_hasNonRailStep && !_hasFerryGateway;

// ── 移動手段タブ（電車・バス / 車）────────────────────────────────
// まず少数のdestinationでテストしてから全件展開する。全件公開時は
// TRANSPORT_TABS_ROLLOUT_ALL を true にする（テストIDリストは残しておく）。
const TRANSPORT_TABS_ROLLOUT_ALL = true;
const TRANSPORT_TABS_TEST_IDS = [
  'abashiri', 'agematsu', 'hakone', 'enoshima', 'togakushi',
  'mashiko', 'choshi', 'amakusa', 'nakijin', 'tomamu',
];
const showTransportTabs: boolean =
  TRANSPORT_TABS_ROLLOUT_ALL || TRANSPORT_TABS_TEST_IDS.includes(dest.id);

// 「車」タブ用: 駐車場情報の抽出。
// 出所の優先順: 1) article.sections[].info の「駐車場：…」行（最も構造化されている）
//               2) dest.spots[].description  3) dest.description の該当文
// いずれも無ければ公式サイト確認の定型文にフォールバックする。
function parkingSentences(text: any): string[] {
  if (!text || typeof text !== 'string') return [];
  return text
    .split(/[\n。]/)
    .map((s: string) => s.trim())
    .filter((s: string) => s.includes('駐車'));
}
const parkingInfo: { spot: string; text: string }[] = [];
const _seenParking = new Set<string>();
function pushParking(spot: string, text: string) {
  const t = text.replace(/^[■・\-–—]\s*/, '').trim();
  const key = `${spot}|${t}`;
  if (!t || t.length > 90 || _seenParking.has(key) || parkingInfo.length >= 6) return;
  _seenParking.add(key);
  parkingInfo.push({ spot, text: t });
}
for (const s of (article?.sections || [])) {
  // 見出しは「スポット名｜キャッチコピー」形式。駐車場の見出しにはスポット名だけ使う。
  const spotName = String(s.title || s.heading || '').split('｜')[0].trim();
  for (const line of parkingSentences(s.info)) pushParking(spotName, line);
}
for (const sp of (((dest as any).spots) || [])) {
  if (typeof sp !== 'object' || !sp || !sp.description) continue;
  for (const line of parkingSentences(sp.description)) pushParking(sp.name || '', line);
}
for (const line of parkingSentences(dest.description)) pushParking('', line);

// レンタカー（車タブのメインコンテンツ）。じゃらんは /rentacar/ が許可リスト形式。
// 楽天レンタカーは置かない（2026-09-17）。アフィリの転送が hb.afl…/travel/<id>/ を必ず経由し、
// そこが楽天アプリのユニバーサルリンク対象のため、タップすると楽天アプリが起動する。
// アフィリを付けたままブラウザで開かせる経路が無いので、じゃらんレンタカーだけにした。
const rentacarJalanUrl = toJalanAffiliate('https://www.jalan.net/rentacar/');

const nearbyDests = (destinations as any[])
  .filter((d: any) => d.id !== dest.id && d.region === dest.region)
  .slice(0, 8);

// 同じ都道府県の他目的地（最大8件）
// 県をまたぐ行（「長野県・岐阜県」等）は、どちらの県から見ても同県として拾う。
const samePrefDests = (destinations as any[])
  .filter((d: any) => d.id !== dest.id && sharesPrefecture(d.prefecture, dest.prefecture))
  .slice(0, 8);
// 見出しは prefecture の表記をそのまま使う（「長野県・岐阜県の他の旅先」）。
// 代表1県＋「ほか」に丸めると「長野県ほかの他の旅先」と重複表現になるため。
const samePrefLabel = dest.prefecture;

// 同じタグを持つ他目的地（最大8件、まずは「離島」「温泉」「絶景」など主要タグ優先）
const PRIMARY_TAGS = ['離島','温泉','絶景','世界遺産','寺社','街歩き','自然','海','山','湖','歴史'];
const destTags: string[] = (dest as any).tags || [];
const primaryTag = destTags.find(t => PRIMARY_TAGS.includes(t)) || destTags[0];
const sameTagDests = primaryTag
  ? (destinations as any[])
      .filter((d: any) => d.id !== dest.id && (d.tags || []).includes(primaryTag))
      .filter((d: any) => !samePrefDests.some(s => s.id === d.id))
      .slice(0, 8)
  : [];

// JSON-LD (TouristAttraction)
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": dest.name,
  "description": description,
  "url": `https://tabidokoiko.com/destinations/${dest.id}/`,
  ...(imageUrl ? { "image": imageUrl } : {}),
  ...(dest.lat && dest.lng ? {
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": dest.lat,
      "longitude": dest.lng,
    }
  } : {}),
  "containedInPlace": {
    "@type": "AdministrativeArea",
    "name": dest.prefecture || dest.region,
  },
});

// ハブ都市ページリンク (自身がhubCityの場合は表示しない)
const _destHubCity = (dest as any).hubCity || hubName || '';
const hubCity = _destHubCity && _destHubCity !== dest.name
  ? (hubCities as any[]).find(h => h.name === _destHubCity)
  : null;
---

