            const gmapDrive = gmapDirUrl(city, true);
            const yahooTransit = `https://transit.yahoo.co.jp/search/result?from=${encodeURIComponent(city)}&to=${encodeURIComponent(dest.name)}`;
            const origPref = CITY_TO_PREF[city] || '';
            const destPref = dest.prefecture || '';
            const service = pickJRService(origPref, destPref);
            const jrHref = jrServiceUrl(service);
            const jrLabelText = jrServiceLabel(service);
            return (
              <div class="travel-time-block" data-city={city}>
                <div class="travel-time-row">
                  <span class="mode-transit-only">🚃 {city}から</span>
                  <span class="mode-car-only">🚗 {city}から</span>
