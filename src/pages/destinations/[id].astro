              <a href={hubJalanUrl} target="_blank" rel="noopener noreferrer" class="hotel-card hotel-card-jalan">
                <div>
                  <p class="hotel-card-name">じゃらんで探す</p>
                  <p class="hotel-card-desc">国内旅行・宿泊予約</p>
                </div>
                <span class="hotel-card-arrow">→</span>
              </a>
            </div>
          </div>
        )}
      </>
    )}
    {showPrefHotel && prefCapital && (
      <div class="hotel-section">
        <h2 class="section-title">{prefCapital}で宿を探す（{dest.name}の拠点）</h2>
        <p class="hotel-description" style="font-size:13px;color:#888;">{prefCapital}を拠点に{dest.name}へ日帰り・宿泊の旅も便利です</p>
        <div class="hotel-cards">
          <a href={prefRakutenUrl} target="_blank" rel="noopener noreferrer" class="hotel-card hotel-card-rakuten">
            <div>
              <p class="hotel-card-name">楽天トラベルで探す</p>
              <p class="hotel-card-desc">ポイントが貯まる・使える</p>
            </div>
            <span class="hotel-card-arrow">→</span>
          </a>
          <a href={prefJalanUrl} target="_blank" rel="noopener noreferrer" class="hotel-card hotel-card-jalan">
            <div>
              <p class="hotel-card-name">じゃらんで探す</p>
              <p class="hotel-card-desc">国内旅行・宿泊予約</p>
            </div>
            <span class="hotel-card-arrow">→</span>
          </a>
        </div>
      </div>
    )}

    <!-- おすすめの宿: 実在・送迎確認済みキュレーション（featured_stay・検索リンクの下に表示） -->
    {featuredStay && (
      <div class="fs-card">
        <div class="fs-body">
          <p class="fs-eyebrow">おすすめの宿はこちら</p>
          <h3 class="fs-name">{featuredStay.name}</h3>
          {featuredStay.catchcopy && <p class="fs-catch">{featuredStay.catchcopy}</p>}
          {(fsShuttleText || featuredStay.accessStation) && (
            <div class="fs-meta">
              {fsShuttleText && <p class="fs-shuttle">🚐 {fsShuttleText}</p>}
              {featuredStay.accessStation && <p class="fs-access">📍 {featuredStay.accessStation}</p>}
            </div>
          )}
          {fsOfficialOnly ? (
            <>
              {featuredStay.bookingNote && <p class="fs-booking-note">{featuredStay.bookingNote}</p>}
              <div class="fs-links">
                <a href={featuredStay.officialUrl} target="_blank" rel="noopener noreferrer" class="fs-link fs-link-official">公式サイトで見る</a>
              </div>
            </>
          ) : (
            <div class="fs-links">
              <a href={fsRakutenUrl} target="_blank" rel="noopener noreferrer" class="fs-link fs-link-rakuten">楽天トラベルで見る</a>
              <a href={fsJalanUrl} target="_blank" rel="noopener noreferrer" class="fs-link fs-link-jalan">じゃらんで見る</a>
            </div>
          )}
        </div>
      </div>
    )}

    <!-- レンタカー（自然・絶景・秘境系のみ） -->
    {(dest as any).rentalCarRecommended && (
      <div class="hotel-section" style="margin-top:24px;">
        <h2 class="section-title">{dest.name}はレンタカーがおすすめ</h2>
        <p class="hotel-description" style="font-size:13px;color:#888;">現地で自由に動きたいならレンタカーが便利です</p>
        <div class="hotel-cards">
          <a href="https://ck.jp.ap.valuecommerce.com/servlet/referral?sid=3764408&pid=892559858&vc_url=https%3A%2F%2Fwww.jalan.net%2Frentacar%2F" target="_blank" rel="noopener noreferrer" class="hotel-card hotel-card-jalan">
            <div>
              <p class="hotel-card-name">じゃらんレンタカー</p>
              <p class="hotel-card-desc">国内旅行・レンタカー予約</p>
            </div>
            <span class="hotel-card-arrow">→</span>
          </a>
        </div>
      </div>
    )}

    <!-- じゃらんレンタカー & じゃらん体験 -->
    {(showLocalHotel || showHubHotel || showPrefHotel) && (
      <>
        {/* 上の「レンタカーがおすすめ」を出した旅先では、同じじゃらんレンタカーが続くので出さない */}
        {!(dest as any).rentalCarRecommended && (
        <div class="rentacar-section">
          <a
            href={rentacarJalanUrl}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="hotel-card rentacar-card"
          >
            <div>
              <p class="hotel-card-name">🚗 レンタカーを探す</p>
              <p class="hotel-card-desc">現地でクルマ移動するならじゃらんレンタカー</p>
            </div>
            <span class="hotel-card-arrow">→</span>
          </a>
        </div>
        )}
        <div class="activity-section">
          <a
            href={toJalanAffiliate(`https://www.jalan.net/activity/?keyword=${encodeURIComponent(dest.name)}`)}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="hotel-card activity-card"
          >
            <div>
              <p class="hotel-card-name">🎫 体験・アクティビティを探す</p>
              <p class="hotel-card-desc">{dest.name}周辺の体験プラン・観光チケット</p>
            </div>
            <span class="hotel-card-arrow">→</span>
          </a>
        </div>
      </>
    )}

    <hr class="section-divider" />

    <!-- 近くの旅先（横スクロール） -->
    {nearbyDests.length > 0 && (
      <div class="nearby-section">
        <h2 class="section-title">近くの旅先</h2>
        <div class="nearby-scroll">
          {nearbyDests.map((d: any) => (
            <a href={`/destinations/${d.id}/`} class="nearby-card">
              <div class="nearby-card-img-wrap">
                <span class="nearby-card-placeholder">{d.name.slice(0, 1)}</span>
                <img
                  class="nearby-card-img"
                  src={`/images/${d.id}/main.jpg`}
                  alt={d.name}
                  loading="lazy"
                  onerror="this.style.display='none'"
                />
              </div>
              <div class="nearby-card-body">
                <div class="nearby-card-name">{d.name}</div>
                <div class="nearby-card-pref">{d.prefecture}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- 同じ都道府県の旅先 -->
    {samePrefDests.length > 0 && (
      <div class="nearby-section">
        <h2 class="section-title">{samePrefLabel}の他の旅先</h2>
        <div class="nearby-scroll">
          {samePrefDests.map((d: any) => (
            <a href={`/destinations/${d.id}/`} class="nearby-card">
              <div class="nearby-card-img-wrap">
                <span class="nearby-card-placeholder">{d.name.slice(0, 1)}</span>
                <img class="nearby-card-img" src={`/images/${d.id}/main.jpg`} alt={d.name} loading="lazy" onerror="this.style.display='none'" />
              </div>
              <div class="nearby-card-body">
                <div class="nearby-card-name">{d.name}</div>
                <div class="nearby-card-pref">{d.prefecture}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- 同じテーマの旅先 -->
    {sameTagDests.length > 0 && primaryTag && (
      <div class="nearby-section">
        <h2 class="section-title">「{primaryTag}」の他の旅先</h2>
        <div class="nearby-scroll">
          {sameTagDests.map((d: any) => (
            <a href={`/destinations/${d.id}/`} class="nearby-card">
              <div class="nearby-card-img-wrap">
                <span class="nearby-card-placeholder">{d.name.slice(0, 1)}</span>
                <img class="nearby-card-img" src={`/images/${d.id}/main.jpg`} alt={d.name} loading="lazy" onerror="this.style.display='none'" />
              </div>
              <div class="nearby-card-body">
                <div class="nearby-card-name">{d.name}</div>
                <div class="nearby-card-pref">{d.prefecture}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- ハブ都市ページリンク -->
    {hubCity && (
      <div id="hub-link" style="margin-top:24px; padding:16px 20px; background:#f7f9f7; border-radius:8px; border:1px solid #e8f0e8;">
        <p style="font-size:12px; color:#999; margin-bottom:6px; letter-spacing:0.06em;">HUB CITY</p>
        <a href={`/hub/${hubCity.id}/`} style="display:flex; align-items:center; justify-content:space-between; text-decoration:none; color:#2A6049; font-size:14px; font-weight:500;">
          <span>{hubCity.name}（拠点都市）から行ける旅先を見る</span>
          <span style="color:#aaa;">→</span>
        </a>
      </div>
    )}

    <!-- シェアボタン -->
    <div class="share-section">
      <span class="share-label">Share</span>
      <canvas id="share-canvas" style="display:none;" width="1200" height="630"
        data-dest-name={dest.name}
        data-dest-id={dest.id}
        data-prefecture={dest.prefecture || ''}
        data-tags={(dest.tags || []).slice(0, 3).join(',')}
      ></canvas>
      <button id="share-card-btn" class="share-card-btn" type="button">
        📤 シェアカードを作る
      </button>
      <button
        class="share-native-btn"
        id="share-native-btn"
        data-title={`【どこ行こ？】${dest.name}への旅｜tabidokoiko.com`}
        data-url={`https://tabidokoiko.com/destinations/${dest.id}/`}
        style="display:none;"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
        この旅先をシェアする
      </button>
      <div class="share-fallback" id="share-fallback">
        <a
          href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(`${dest.name}に行ってみたい！ #どこ行こ`)}&url=${encodeURIComponent(`https://tabidokoiko.com/destinations/${dest.id}/`)}`}
          target="_blank" rel="noopener noreferrer"
          class="share-x-btn"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.748l7.73-8.835L1.254 2.25H8.08l4.259 5.63zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          X でシェア
        </a>
        <a
          href={`https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(`https://tabidokoiko.com/destinations/${dest.id}/`)}`}
          target="_blank" rel="noopener noreferrer"
          class="share-line-btn"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg>
          LINE でシェア
        </a>
      </div>
    </div>

    <!-- CTA -->
    <div class="cta-section">
      <span class="cta-label">Travel Planning</span>
      <p class="cta-title">旅先を1分で決めてみる？</p>
      <a href="/" class="cta-btn">どこ行こ？で旅先を探す →</a>
    </div>

  </div>
</DestinationLayout>

<script>
  // 出発地ピッカー: 全都市blockが既に静的生成済み。selectで該当blockを表示する。
  const departureSelect = document.getElementById('departure-select') as HTMLSelectElement | null;
  const emptyMsg = document.getElementById('access-empty-msg');
  const noDataMsg = document.getElementById('access-no-data-msg');
  if (departureSelect) {
    departureSelect.addEventListener('change', () => {
      const city = departureSelect.value;
      const blocks = document.querySelectorAll<HTMLElement>('.travel-time-block');
      blocks.forEach(b => b.classList.remove('selected'));
      if (noDataMsg) { noDataMsg.style.display = 'none'; noDataMsg.textContent = ''; }
      if (!city) {
        if (emptyMsg) emptyMsg.classList.remove('hidden');
        return;
      }
      const target = document.querySelector<HTMLElement>(`.travel-time-block[data-city="${city}"]`);
      if (target) {
        target.classList.add('selected');
        if (emptyMsg) emptyMsg.classList.add('hidden');
        target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        if (emptyMsg) emptyMsg.classList.add('hidden');
        // 「未登録」テキストは表示しない (ユーザー要求)
      }
    });
  }

  const nativeBtn = document.getElementById('share-native-btn') as HTMLButtonElement | null;
  const fallback  = document.getElementById('share-fallback') as HTMLElement | null;

  if (nativeBtn && fallback) {
    if (navigator.share) {
      nativeBtn.style.display = 'flex';
      fallback.style.display  = 'none';
      nativeBtn.addEventListener('click', async () => {
        try {
          await navigator.share({
            title: nativeBtn.dataset.title ?? '',
            url:   nativeBtn.dataset.url   ?? window.location.href,
          });
        } catch (_) { /* user cancelled */ }
      });
    } else {
      nativeBtn.style.display = 'none';
      fallback.style.display  = 'flex';
    }
  }

  // fold toggle
  document.querySelectorAll<HTMLButtonElement>('[data-fold-btn]').forEach(btn => {
    btn.addEventListener('click', () => {
      const prev = btn.previousElementSibling as HTMLElement | null;
      if (prev) prev.classList.remove('folded');
      btn.style.display = 'none';
    });
  });

  // share card canvas
  const shareCardBtn = document.getElementById('share-card-btn') as HTMLButtonElement | null;
  const shareCanvas  = document.getElementById('share-canvas')  as HTMLCanvasElement | null;

  if (shareCardBtn && shareCanvas) {
    shareCardBtn.addEventListener('click', async () => {
      shareCardBtn.textContent = '作成中…';
      shareCardBtn.disabled = true;

      const ctx = shareCanvas.getContext('2d')!;
      const W = 1200, H = 630;
      const destName  = shareCanvas.dataset.destName  || '';
      const prefecture = shareCanvas.dataset.prefecture || '';
      const tags = (shareCanvas.dataset.tags || '').split(',').filter(Boolean);
      const destId = shareCanvas.dataset.destId || '';

      // Background
      ctx.fillStyle = '#1e4a35';
      ctx.fillRect(0, 0, W, H);
      const grad = ctx.createLinearGradient(0, 0, W, H);
      grad.addColorStop(0, 'rgba(42,96,73,0.85)');
      grad.addColorStop(1, 'rgba(15,45,30,0.95)');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, W, H);

      // Subtle grid pattern
      ctx.strokeStyle = 'rgba(255,255,255,0.04)';
      ctx.lineWidth = 1;
      for (let x = 0; x <= W; x += 60) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke(); }
      for (let y = 0; y <= H; y += 60) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke(); }

      await document.fonts.ready;

      // Logo (top-left)
      ctx.fillStyle = 'rgba(255,255,255,0.9)';
      ctx.font = 'bold 26px sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText('どこ行こ？', 56, 66);

      // Departure (bottom-left)
      const dep = localStorage.getItem('departure') || '全国';
      ctx.fillStyle = 'rgba(255,255,255,0.65)';
      ctx.font = '22px sans-serif';
      ctx.fillText(`${dep}から`, 56, H - 36);

      // Destination name (center)
      ctx.fillStyle = '#ffffff';
      ctx.font = `bold 92px "Noto Serif JP", "Hiragino Mincho ProN", serif`;
      ctx.textAlign = 'center';
      ctx.fillText(destName, W / 2, H / 2 + 10);

      // Horizontal rule above/below name
      ctx.strokeStyle = 'rgba(255,255,255,0.25)';
      ctx.lineWidth = 1;
      const textWidth = ctx.measureText(destName).width;
      const lineMargin = 24;
      ctx.beginPath(); ctx.moveTo(W/2 - textWidth/2 - lineMargin, H/2 - 68); ctx.lineTo(W/2 + textWidth/2 + lineMargin, H/2 - 68); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(W/2 - textWidth/2 - lineMargin, H/2 + 40); ctx.lineTo(W/2 + textWidth/2 + lineMargin, H/2 + 40); ctx.stroke();

      // Prefecture
      ctx.fillStyle = 'rgba(255,255,255,0.75)';
      ctx.font = '28px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(prefecture, W / 2, H / 2 + 80);

      // Tags
      if (tags.length) {
        ctx.fillStyle = 'rgba(255,255,255,0.55)';
        ctx.font = '22px sans-serif';
        ctx.fillText(tags.slice(0, 2).join('　·　'), W / 2, H / 2 + 122);
      }

      // URL (bottom-right)
      ctx.fillStyle = 'rgba(255,255,255,0.5)';
      ctx.font = '20px sans-serif';
      ctx.textAlign = 'right';
      ctx.fillText('tabidokoiko.com', W - 56, H - 36);

      shareCanvas.toBlob(async (blob) => {
        if (!blob) {
          shareCardBtn.textContent = '📤 シェアカードを作る';
          shareCardBtn.disabled = false;
          return;
        }
        const file = new File([blob], 'dokoiko-share.jpg', { type: 'image/jpeg' });
        const shareUrl = `https://tabidokoiko.com/destinations/${destId}/`;
        try {
          if (navigator.canShare && navigator.canShare({ files: [file] })) {
            await navigator.share({ files: [file], title: `【どこ行こ？】${destName}`, url: shareUrl });
          } else {
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = `dokoiko-${destId}.jpg`;
            a.click();
          }
        } catch (_) { /* user cancelled */ }
        shareCardBtn.textContent = '📤 シェアカードを作る';
        shareCardBtn.disabled = false;
      }, 'image/jpeg', 0.92);
    });
  }
</script>
