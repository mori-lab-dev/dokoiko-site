                <div class="travel-booking-row-stack">
                  {/* 車タブでは最上部のルート検索リンクとして表示する */}
                  <a href={gmapDrive} target="_blank" rel="noopener noreferrer" class="booking-btn booking-btn-drive mode-car-btn">
                    <span class="booking-btn-label">🚗 車のルートを検索</span>
                    <span class="booking-btn-arrow">→</span>
                  </a>
                  <a href={gmap} target="_blank" rel="noopener noreferrer" class="booking-btn booking-btn-route mode-transit-only">
                    <span class="booking-btn-label">地図で経路を見る</span>
                    <span class="booking-btn-arrow">→</span>
                  </a>
                  {isRailReachable && (
                    <a href={yahooTransit} target="_blank" rel="noopener noreferrer" class="booking-btn booking-btn-navitime mode-transit-only">
                      <span class="booking-btn-label">電車・バスで行く</span>
                      <span class="booking-btn-arrow">→</span>
                    </a>
                  )}
                  {service === 'air' ? (
                    skyscannerUrl(city, dest) ? (
                      <a href={skyscannerUrl(city, dest)} target="_blank" rel="noopener noreferrer" class="booking-btn booking-btn-sky mode-transit-only">
                        <span class="booking-btn-label">✈️ スカイスキャナーで航空券を探す</span>
                        <span class="booking-btn-arrow">→</span>
                      </a>
                    ) : (
                      <span class="air-note mode-transit-only">✈️ 飛行機でのアクセスがおすすめ</span>
                    )
                  ) : service === 'midori' ? (
                    <span class="midori-note mode-transit-only">🟢 みどりの窓口での購入がおすすめ</span>
                  ) : (
                    <a href={jrHref} target="_blank" rel="noopener noreferrer" class="booking-btn booking-btn-jr mode-transit-only">
                      <span class="booking-btn-label">{jrLabelText}で予約</span>
                      <span class="booking-btn-arrow">→</span>
                    </a>
                  )}
                </div>
              </div>
            );
          })}
        <div class="access-no-data-msg" id="access-no-data-msg" style="display:none;font-size:13px;color:#888;padding:12px 0;"></div>
      </div>
      {showTransportTabs && (
        <div class="car-pane">
          <div class="car-rentacar">
            <p class="car-rentacar-title">🚗 レンタカーを予約する</p>
            <p class="car-rentacar-desc">{dest.name}を車でまわるなら、出発地・現地どちらでも借りられます</p>
            <div class="hotel-cards">
              <a href={rentacarJalanUrl} target="_blank" rel="nofollow sponsored noopener" class="hotel-card hotel-card-jalan">
                <div>
                  <p class="hotel-card-name">じゃらんレンタカー</p>
                  <p class="hotel-card-desc">国内旅行・レンタカー予約</p>
                </div>
                <span class="hotel-card-arrow">→</span>
              </a>
            </div>
          </div>
          <div class="car-parking">
            <span class="car-parking-label">Parking</span>
            {parkingInfo.length > 0 ? (
              parkingInfo.map((p: { spot: string; text: string }) => (
                <div class="car-parking-item">
                  {p.spot && <span class="car-parking-spot">{p.spot}</span>}
                  <span class="car-parking-text">{p.text}</span>
                </div>
              ))
            ) : (
              <p class="car-parking-empty">現地の駐車場情報は公式サイトでご確認ください</p>
            )}
          </div>
        </div>
      )}
      {dest.access?.steps && dest.access.steps.length > 0 ? (
        <div class="access-steps">
          {dest.access.steps.length <= 2 ? (
            dest.access.steps.map((step: any, i: number) => (
              <>
                <div class="access-step">
                  <span class="step-type">{STEP_TYPE_LABEL[step.type] || '移動'}</span>
                  <span>{(step.to || step.from) + 'へ'}</span>
                </div>
                {i < dest.access.steps.length - 1 && <div class="step-arrow">↓</div>}
              </>
            ))
          ) : (
            <>
              <div class="access-step">
                <span class="step-type">{STEP_TYPE_LABEL[dest.access.steps[0].type] || '移動'}</span>
                <span>{(dest.access.steps[0].to || dest.access.steps[0].from) + 'へ'}</span>
              </div>
              <div class="step-arrow">↓</div>
              <details class="access-step-middle">
                <summary>途中の乗換 {dest.access.steps.length - 2} 件を表示</summary>
                <div class="access-step-middle-inner">
                  {dest.access.steps.slice(1, -1).map((step: any, i: number, arr: any[]) => (
                    <>
                      <div class="access-step">
                        <span class="step-type">{STEP_TYPE_LABEL[step.type] || '移動'}</span>
                        <span>{(step.to || step.from) + 'へ'}</span>
                      </div>
                      {i < arr.length - 1 && <div class="step-arrow">↓</div>}
                    </>
                  ))}
                </div>
              </details>
              <div class="step-arrow">↓</div>
              <div class="access-step">
                <span class="step-type">{STEP_TYPE_LABEL[dest.access.steps[dest.access.steps.length-1].type] || '移動'}</span>
                <span>{(dest.access.steps[dest.access.steps.length-1].to || dest.access.steps[dest.access.steps.length-1].from) + 'へ'}</span>
              </div>
            </>
          )}
        </div>
      ) : (
        <div class="access-steps">
          {(dest as any).gateways?.rail?.length > 0 && (
            <div class="access-step">
              <span class="step-type">鉄道</span>
              <span>{(dest as any).gateways.rail.join(' / ')}</span>
            </div>
          )}
          {(dest as any).gateways?.airport?.length > 0 && (
            <>
              {(dest as any).gateways?.rail?.length > 0 && <div class="step-arrow">↓</div>}
              <div class="access-step">
                <span class="step-type">航空</span>
                <span>{(dest as any).gateways.airport.join(' / ')}</span>
              </div>
            </>
          )}
          {(dest as any).gateways?.ferry?.length > 0 && (
            <div class="access-step">
              <span class="step-type">船</span>
              <span>{(dest as any).gateways.ferry.join(' / ')}</span>
            </div>
          )}
          {(dest as any).railNote && (
            <div class="access-step" style="background: #f8f8f8; border-color: #e0e0e0;">
              <span class="step-type">備考</span>
              <span style="font-size: 12px; color: #777;">{(dest as any).railNote}</span>
            </div>
          )}
        </div>
      )}
    </div>

    <hr class="section-divider" id="hotel" />


    <!-- 宿泊: 現地泊 / hub泊 / 県庁所在地fallback。離島系 (showDualHotel) はタブ表示 -->
    {showDualHotel ? (
      <div class="hotel-section hotel-tabs">
        <input type="radio" id={`${dest.id}-tab-local`} name={`${dest.id}-hotel-tab`} class="hotel-tab-radio hotel-tab-radio-local" checked />
        <input type="radio" id={`${dest.id}-tab-hub`} name={`${dest.id}-hotel-tab`} class="hotel-tab-radio hotel-tab-radio-hub" />
        <div class="hotel-tab-headers">
          <label for={`${dest.id}-tab-local`} class="hotel-tab-label hotel-tab-label-local">{dest.name}の宿</label>
          <label for={`${dest.id}-tab-hub`} class="hotel-tab-label hotel-tab-label-hub">{hubCityName}の宿（拠点）</label>
        </div>
        <div class="hotel-tab-content hotel-tab-content-local">
          {stayNote && <p class="hotel-description">{stayNote}</p>}
          <div class="hotel-cards">
            <a href={rakutenHotelUrl} target="_blank" rel="noopener noreferrer" class="hotel-card hotel-card-rakuten">
              <div>
                <p class="hotel-card-name">楽天トラベルで探す</p>
                <p class="hotel-card-desc">ポイントが貯まる・使える</p>
              </div>
              <span class="hotel-card-arrow">→</span>
            </a>
            <a href={jalanHotelUrl} target="_blank" rel="noopener noreferrer" class="hotel-card hotel-card-jalan">
              <div>
                <p class="hotel-card-name">じゃらんで探す</p>
                <p class="hotel-card-desc">国内旅行・宿泊予約</p>
              </div>
              <span class="hotel-card-arrow">→</span>
            </a>
          </div>
        </div>
        <div class="hotel-tab-content hotel-tab-content-hub">
          <p class="hotel-description" style="font-size:13px;color:#888;">{hubCityName}を拠点に{dest.name}へ日帰り・宿泊の旅も便利です</p>
          <div class="hotel-cards">
            <a href={hubRakutenUrl} target="_blank" rel="noopener noreferrer" class="hotel-card hotel-card-rakuten">
              <div>
                <p class="hotel-card-name">楽天トラベルで探す</p>
                <p class="hotel-card-desc">ポイントが貯まる・使える</p>
              </div>
              <span class="hotel-card-arrow">→</span>
            </a>
            <a href={hubJalanUrl} target="_blank" rel="noopener noreferrer" class="hotel-card hotel-card-jalan">
              <div>
                <p class="hotel-card-name">じゃらんで探す</p>
                <p class="hotel-card-desc">国内旅行・宿泊予約</p>
              </div>
              <span class="hotel-card-arrow">→</span>
            </a>
          </div>
        </div>
      </div>
    ) : (
      <>
        {showLocalHotel && (
          <div class="hotel-section">
            <h2 class="section-title">{dest.name}の宿を探す</h2>
            {stayNote && <p class="hotel-description">{stayNote}</p>}
            <div class="hotel-cards">
              <a href={rakutenHotelUrl} target="_blank" rel="noopener noreferrer" class="hotel-card hotel-card-rakuten">
                <div>
                  <p class="hotel-card-name">楽天トラベルで探す</p>
                  <p class="hotel-card-desc">ポイントが貯まる・使える</p>
                </div>
                <span class="hotel-card-arrow">→</span>
              </a>
              <a href={jalanHotelUrl} target="_blank" rel="noopener noreferrer" class="hotel-card hotel-card-jalan">
                <div>
                  <p class="hotel-card-name">じゃらんで探す</p>
                  <p class="hotel-card-desc">国内旅行・宿泊予約</p>
                </div>
                <span class="hotel-card-arrow">→</span>
              </a>
            </div>
          </div>
        )}
        {showHubHotel && (
          <div class="hotel-section" style={showLocalHotel ? 'margin-top:24px;' : ''}>
            <h2 class="section-title">{hubCityName}で宿を探す（{dest.name}の拠点）</h2>
            <p class="hotel-description" style="font-size:13px;color:#888;">{hubCityName}を拠点に{dest.name}へ日帰り・宿泊の旅も便利です</p>
            <div class="hotel-cards">
              <a href={hubRakutenUrl} target="_blank" rel="noopener noreferrer" class="hotel-card hotel-card-rakuten">
                <div>
                  <p class="hotel-card-name">楽天トラベルで探す</p>
                  <p class="hotel-card-desc">ポイントが貯まる・使える</p>
