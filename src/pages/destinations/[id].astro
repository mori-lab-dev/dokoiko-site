  <!-- Hero: 画像あり / なし で分岐 -->
  {imageUrl ? (
    <div class="dest-hero">
      <img class="dest-hero-img" src={imageUrl} alt={dest.mainSpot ? `${dest.name}の${dest.mainSpot}` : `${dest.name}の風景`} />
      <div class="dest-hero-gradient"></div>
      <div class="dest-hero-content">
        <span class="dest-hero-pref">{dest.prefecture}</span>
        <h1 class="dest-hero-title">{dest.name}</h1>
        {dest.tags && dest.tags.length > 0 && (
          <div class="dest-hero-tags">
            {dest.tags.filter((t: any) => typeof t === 'string').slice(0, 5).map((tag: string) => (
              <span class="dest-hero-tag">{tag}</span>
            ))}
          </div>
        )}
      </div>
      {heroCredit && (
        <p class="dest-hero-credit">
          {heroCredit.url ? (
            <a href={heroCredit.url} target="_blank" rel="noopener noreferrer nofollow">
              Photo by {heroCredit.author || 'Unknown'} / Wikimedia Commons{heroCredit.license ? ` (${heroCredit.license})` : ''}
            </a>
          ) : (
            <span>Photo by {heroCredit.author || 'Unknown'} / Wikimedia Commons{heroCredit.license ? ` (${heroCredit.license})` : ''}</span>
          )}
        </p>
      )}
    </div>
  ) : (
    <div class="dest-header-noimg">
      <span class="dest-noimg-pref">{dest.prefecture}</span>
      <h1 class="dest-noimg-title">{dest.name}</h1>
      {dest.tags && dest.tags.length > 0 && (
        <div class="dest-noimg-tags">
          {dest.tags.filter((t: any) => typeof t === 'string').slice(0, 5).map((tag: string) => (
            <span class="dest-noimg-tag">{tag}</span>
          ))}
        </div>
      )}
    </div>
  )}

  <div class="content">

    <!-- Unsplash クレジット -->
    {unsplashCredit && (
      <p style="font-size:10px; color:#bbb; text-align:right; margin:-8px 0 12px; letter-spacing:0.04em;">
        Photo by <a href={unsplashCreditUrl} target="_blank" rel="noopener noreferrer" style="color:#bbb; text-decoration:underline;">{unsplashCredit}</a> on <a href={unsplashPhotoUrl} target="_blank" rel="noopener noreferrer" style="color:#bbb; text-decoration:underline;">Unsplash</a>
      </p>
    )}

    <!-- パンくず -->
    <nav class="breadcrumb">
      <a href="/">HOME</a> ›
      <a href="/destinations/">{dest.region || dest.prefecture}</a> ›
      <span>{dest.name}</span>
    </nav>

    <!-- reasonChips -->
    {(dest as any).reasonChips?.length > 0 && (
      <div class="reason-chips">
        {(dest as any).reasonChips.map((chip: string) => (
          <span class="reason-chip">{chip}</span>
        ))}
      </div>
    )}

    <!-- リード文: article.lead は導入詩として短い（最大163字）ため dest.description を併記 -->
    {article?.lead && (
      article.lead.length > 80 ? (
        <div class="fold-wrap">
          <p class="lead folded">{article.lead}</p>
          <button class="fold-btn" type="button" data-fold-btn>続きを読む ↓</button>
        </div>
      ) : (
        <p class="lead">{article.lead}</p>
      )
    )}
    {dest.description && (
      dest.description.length > 80 ? (
        <div class="fold-wrap">
          <p class="dest-description folded">{dest.description}</p>
          <button class="fold-btn" type="button" data-fold-btn>続きを読む ↓</button>
        </div>
      ) : (
        <p class="dest-description">{dest.description}</p>
      )
    )}

    <!-- 実用情報カード -->
    <div class="info-cards">
      {article?.bestSeason ? (
        <div class="info-card">
          <div class="info-card-label">Best Season</div>
          <div class="info-card-value">{article.bestSeason}</div>
        </div>
      ) : (
        <div class="info-card">
          <div class="info-card-label">Best Season</div>
          <div class="info-card-value">通年OK・四季それぞれの魅力</div>
        </div>
      )}
      <div class="info-card">
        <div class="info-card-label">Stay</div>
        <div class="info-card-value">
          {(dest as any).stayAllowed?.includes('daytrip') ? '日帰り可能' : ''}
          {(dest as any).stayAllowed?.includes('1night') ? (((dest as any).stayAllowed?.includes('daytrip') ? '・' : '') + '1泊おすすめ') : ''}
          {(dest as any).stayAllowed?.some((s: string) => s === '2night' || s === '3night+') ? '・2泊以上' : ''}
        </div>
      </div>
    </div>

    <!-- どこから行く？ショートカット -->
    {travelTimes.length > 0 && (
      <a href="#access" class="access-shortcut">
        <span>📍 どこから行く？アクセス情報を見る</span>
        <span class="access-shortcut-arrow">↓</span>
      </a>
    )}


    <!-- スポット (article.sections優先、なければ dest.spots を簡易表示) -->
    {article?.sections && article.sections.length > 0 ? (
      <div>
        <h2 class="spots-heading">{dest.name}のおすすめスポット</h2>
        {article.sections.map((section: any, i: number) => {
          const sectionTitle = section.title || section.heading || '';
          // dest.spots から同名スポットの imageUrl を探す
          const matchSpot = ((dest as any).spots || []).find((s: any) =>
            (typeof s === 'object' && s.name && (sectionTitle.includes(s.name) || s.name.includes(sectionTitle)))
          );
          const spotImg = matchSpot?.imageUrl;
          // 画像を借りてきた以上、CC BY / CC BY-SA は著作者表示が要る（下の分岐と同じ扱い）。
          const msc = matchSpot?.imageCredit || null;
          const spotImgCredit = (spotImg && msc && msc.attributionRequired !== false
            && (msc.author || msc.license)) ? msc : null;
          return (
            <div class="spot-section">
              <span class="spot-num">{String(i + 1).padStart(2, '0')}</span>
              <div class={spotImg ? 'spot-with-img' : ''}>
                {spotImg && (
                  <figure class="spot-figure">
                    <img class="spot-thumb" src={spotImg} alt={`${dest.name}の${sectionTitle}`} loading="lazy" onerror="this.style.display='none'" />
                    {spotImgCredit && (
                      <figcaption class="spot-credit">
                        {spotImgCredit.url
                          ? <a href={spotImgCredit.url} target="_blank" rel="noopener noreferrer">{spotImgCredit.author || '作者不明'}</a>
                          : (spotImgCredit.author || '作者不明')}
                        {spotImgCredit.license ? ` / ${spotImgCredit.license}` : ''}
                      </figcaption>
                    )}
                  </figure>
                )}
                <div class="spot-content">
                  <h3 class="spot-title">{sectionTitle}</h3>
                  <div class="spot-body">
                    {section.body.split('\n').map((p: string) => p.trim()).filter(Boolean).map((p: string) => (
                      <p>{p}</p>
                    ))}
                  </div>
                  {section.info && <div class="spot-info">{section.info}</div>}
                  <a href={gmapSpotUrl(sectionTitle)} target="_blank" rel="noopener noreferrer" class="spot-map">地図で見る →</a>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    ) : (((dest as any).spots && (dest as any).spots.length > 0) && (
      <div>
        <h2 class="spots-heading">{dest.name}のおすすめスポット</h2>
        {((dest as any).spots).map((spot: any, i: number) => {
          const name = typeof spot === 'string' ? spot : spot.name;
          const imageUrl = typeof spot === 'object' ? spot.imageUrl : null;
          const spotDesc = typeof spot === 'object' ? spot.description : null;
          // spot画像はほとんどが Wikimedia Commons 由来で、CC BY / CC BY-SA は
          // 著作者表示が条件になっている。データには imageCredit が入っていたのに
          // 描画されておらず、表示義務を満たしていなかったのでここで出す。
          // CC0・パブリックドメインは義務が無いので出さない。
          const sc = (typeof spot === 'object' && spot.imageCredit) || null;
          const spotCredit = (imageUrl && sc && sc.attributionRequired !== false
            && (sc.author || sc.license)) ? sc : null;
          return (
            <div class="spot-section">
              <span class="spot-num">{String(i + 1).padStart(2, '0')}</span>
              <div class={imageUrl ? 'spot-with-img' : ''}>
                {imageUrl && (
                  <figure class="spot-figure">
                    <img class="spot-thumb" src={imageUrl} alt={`${dest.name}の${name}`} loading="lazy" onerror="this.style.display='none'" />
                    {spotCredit && (
                      <figcaption class="spot-credit">
                        {spotCredit.url
                          ? <a href={spotCredit.url} target="_blank" rel="noopener noreferrer">{spotCredit.author || '作者不明'}</a>
                          : (spotCredit.author || '作者不明')}
                        {spotCredit.license ? ` / ${spotCredit.license}` : ''}
                      </figcaption>
                    )}
                  </figure>
                )}
                <div class="spot-content">
                  <h3 class="spot-title">{name}</h3>
                  {spotDesc && (
                    <div class="spot-body"><p>{spotDesc}</p></div>
                  )}
                  <a href={gmapSpotUrl(name)} target="_blank" rel="noopener noreferrer" class="spot-map">地図で見る →</a>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    ))}

    <!-- モデルコース -->
    {article?.modelCourse && (
      <div class="course-section">
        <h2>モデルコース</h2>
