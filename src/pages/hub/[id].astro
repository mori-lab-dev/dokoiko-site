---
import DestinationLayout from '../../layouts/DestinationLayout.astro';
import destinations from '../../data/destinations.json';
import hubCities from '../../data/hubCities.json';
import { jalanKeywordSearchTarget } from '../../../scripts/jalanUrl.js';
import fs from 'fs';
import path from 'path';

export function getStaticPaths() {
  return hubCities.map(hub => ({
    params: { id: hub.id },
    props: { hub },
  }));
}

const { hub } = Astro.props;

const RAKUTEN_AFF = 'https://hb.afl.rakuten.co.jp/hgc/5113ee4b.8662cfc5.5113ee4c.119de89a/';
const JALAN_AFF  = 'https://ck.jp.ap.valuecommerce.com/servlet/referral?sid=3764408&pid=892559858&vc_url=';

// 県トップ（/yado/{県}/）は楽天トラベルアプリの起動対象なので使わない（2026-09-17）。
// じゃらんと同じく拠点名でキーワード検索する。
const rakutenUrl = `${RAKUTEN_AFF}?pc=${encodeURIComponent('https://kw.travel.rakuten.co.jp/keyword/Search.do?f_query=' + encodeURIComponent(hub.name))}`;
// キーワードはSJISエンコード必須(scripts/jalanUrl.js参照。UTF-8のままだと文字化け0件)
const jalanUrl   = `${JALAN_AFF}${encodeURIComponent(jalanKeywordSearchTarget(hub.name))}`;

// hub.id → travelTime key 変換（一部不一致あり）
const HUB_TT_KEY: Record<string, string> = {
  miyakojima: 'miyako',
};
const ttKey = HUB_TT_KEY[hub.id] || hub.id;

// このハブからアクセス可能な目的地（travelTime優先、d.hub fallback）
const hubDests = (destinations as any[])
  .filter(d => d.id !== hub.id)  // hub自身は除外
  .map(d => {
    const tt = (d.travelTime || {})[ttKey];
    const isExplicitHub = d.hub === hub.name;
    return {
      ...d,
      _tt: tt,
      _isHub: isExplicitHub,
    };
  })
  .filter(d => d._tt !== undefined || d._isHub)
  .sort((a, b) => (a._tt || 999) - (b._tt || 999));

const imgDir = path.join(process.cwd(), 'public/images');
function destImageUrl(d: any): string | null {
  if (fs.existsSync(path.join(imgDir, d.id, 'main.jpg'))) return `/images/${d.id}/main.jpg`;
  if (fs.existsSync(path.join(imgDir, `${d.id}.jpg`))) return `/images/${d.id}.jpg`;
  if (d.unsplashUrl) return d.unsplashUrl;
  return null;
}

// === 1. stayAllowed タブ用カウント ===
const daytripDests = hubDests.filter((d: any) => (d.stayAllowed || []).includes('daytrip') && (d._tt || 999) <= 120);
const oneNightDests = hubDests.filter((d: any) => (d.stayAllowed || []).includes('1night'));
const twoNightDests = hubDests.filter((d: any) =>
  (d.stayAllowed || []).some((s: string) => s === '2night' || s === '3night+')
);

// === 2. テーマ別 ===
const THEMES = [
  { key: '温泉',      label: '温泉',      emoji: '♨' },
  { key: '離島',      label: '離島',      emoji: '🏝' },
  { key: '絶景',      label: '絶景',      emoji: '🏞' },
  { key: '歴史',      label: '歴史',      emoji: '🏯' },
  { key: 'グルメ',    label: 'グルメ',    emoji: '🍣' },
  { key: '自然',      label: '自然',      emoji: '🌳' },
  { key: '街歩き',    label: '街歩き',    emoji: '🚶' },
  { key: '世界遺産',  label: '世界遺産',  emoji: '🌏' },
];
const themeSections = THEMES.map(t => ({
  ...t,
  dests: hubDests.filter((d: any) => (d.tags || []).includes(t.key)).slice(0, 6),
})).filter(t => t.dests.length > 0);

// === 3. 距離ゾーン別 ===
const zone1 = hubDests.filter((d: any) => d._tt > 0 && d._tt <= 60);
const zone2 = hubDests.filter((d: any) => d._tt > 60 && d._tt <= 120);
const zone3 = hubDests.filter((d: any) => d._tt > 120 && d._tt <= 180);

// === 5. 季節おすすめ ===
const SEASON_TAGS: Record<string, string[]> = {
  spring: ['春', '桜', '花', '新緑'],
  summer: ['夏', '海', '海水浴', '花火'],
  autumn: ['秋', '紅葉', '紅葉狩り'],
  winter: ['冬', '雪', 'スキー', '温泉', '雪見'],
};
const SEASON_LABEL: Record<string, string> = { spring: '春', summer: '夏', autumn: '秋', winter: '冬' };
const seasonalDests: Record<string, any[]> = {};
for (const [season, tags] of Object.entries(SEASON_TAGS)) {
  seasonalDests[season] = hubDests
    .filter((d: any) => (d.tags || []).some((t: string) => tags.includes(t)))
    .slice(0, 3);
}

// ハブ自身の画像
const hubImage = fs.existsSync(path.join(imgDir, `${hub.id}.jpg`))
  ? `https://tabidokoiko.com/images/${hub.id}.jpg`
  : null;

const title = `${hub.name}を拠点に旅する｜${hub.prefecture}から行けるおすすめ旅先${hubDests.length}選`;
const description = `${hub.desc.slice(0, 100)} ${hub.name}を起点に日帰り・宿泊で行けるおすすめ旅先${hubDests.length}か所を紹介。`;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "City",
  "name": hub.name,
  "description": hub.desc,
  "url": `https://tabidokoiko.com/hub/${hub.id}/`,
  "containedInPlace": {
    "@type": "AdministrativeArea",
    "name": hub.prefecture,
  },
});
---

<DestinationLayout title={title} description={description} image={hubImage}>
  <script type="application/ld+json" set:html={jsonLd} slot="head-extra" />

  <style>
    .hub-hero {
      position: relative;
      height: 200px;
      overflow: hidden;
      background: #1a2e20;
    }
    .hub-hero-img {
      width: 100%; height: 100%;
      object-fit: cover;
      object-position: center 40%;
      opacity: 0.75;
    }
    .hub-hero-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0.1) 60%);
    }
    .hub-hero-text {
      position: absolute; bottom: 0; left: 0; right: 0;
      padding: 0 24px 24px;
    }
    .hub-hero-pref { color: rgba(255,255,255,0.8); font-size: 11px; letter-spacing: 0.18em; margin-bottom: 8px; text-transform: uppercase; }
    .hub-hero-title { color: #fff; font-family: 'Noto Serif JP', serif; font-size: 28px; font-weight: 300; letter-spacing: 0.06em; margin-bottom: 6px; }
    .hub-hero-count { color: rgba(255,255,255,0.85); font-size: 12px; letter-spacing: 0.05em; }

    .hub-body { max-width: 680px; margin: 0 auto; padding: 28px 20px 60px; }

    /* hub説明 */
    .hub-desc {
      padding: 20px 22px;
      background: #f8fdf9;
      border-left: 3px solid #2A6049;
      border-radius: 0 6px 6px 0;
      font-size: 14px;
      color: #444;
      line-height: 2;
      letter-spacing: 0.02em;
      margin-bottom: 36px;
    }

    /* タブ */
    .stay-tabs {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 6px;
      margin-bottom: 28px;
      background: #fff;
      position: sticky;
      top: 0;
      z-index: 10;
      padding: 8px 0;
    }
    .stay-tab {
      padding: 12px 8px;
      border: 1px solid #e0e0e0;
      border-radius: 8px;
      background: #fff;
      color: #777;
      font-size: 13px;
      letter-spacing: 0.04em;
      cursor: pointer;
      transition: all 0.15s;
      text-align: center;
      font-family: inherit;
    }
    .stay-tab.active {
      background: #2A6049;
      color: #fff;
      border-color: #2A6049;
    }
    .stay-tab-label { display: block; font-weight: 500; }
    .stay-tab-count { display: block; font-size: 10px; margin-top: 2px; opacity: 0.8; }

    /* セクション */
    .section { margin: 0 0 48px; }
    .section-eyebrow {
      font-size: 10px;
      letter-spacing: 0.22em;
      color: #9a7c36;
      text-transform: uppercase;
      display: block;
      margin-bottom: 6px;
    }
    .section-title {
      font-family: 'Noto Serif JP', serif;
      font-size: 20px;
      font-weight: 400;
      color: #1a1a1a;
      letter-spacing: 0.04em;
      margin-bottom: 16px;
    }

    /* 横スクロール card */
    .h-scroll {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      padding-bottom: 8px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      margin: 0 -20px 0 0;
      padding-right: 20px;
    }
    .h-scroll::-webkit-scrollbar { display: none; }
    .h-card {
      flex: 0 0 160px;
      display: block;
      text-decoration: none;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 2px 6px rgba(0,0,0,0.06);
      background: #fff;
      transition: transform 0.15s;
    }
    .h-card:hover { transform: translateY(-2px); }
    .h-card-img-wrap { position: relative; height: 100px; background: #f0f0f0; }
    .h-card-img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .h-card-body { padding: 10px 12px 14px; }
    .h-card-name { font-size: 13px; font-weight: 500; color: #1a1a1a; margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .h-card-meta { font-size: 10px; color: #999; letter-spacing: 0.04em; }
    .h-card-time { color: #C9A84C; font-size: 10px; margin-top: 4px; }

    /* もっと見る */
    .more-link {
      display: block;
      text-align: right;
      font-size: 12px;
      color: #2A6049;
      margin-top: 12px;
      letter-spacing: 0.05em;
    }

    /* 季節セクション */
    .season-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
    }
    @media (min-width: 640px) {
      .season-grid { grid-template-columns: 1fr 1fr; }
    }
    .season-block { background: #fafafa; border-radius: 10px; padding: 16px; }
    .season-title { font-size: 14px; color: #2A6049; font-weight: 500; margin-bottom: 10px; }
    .season-list { display: flex; flex-direction: column; gap: 8px; }
    .season-item {
      display: flex; gap: 10px; align-items: center;
      text-decoration: none;
      padding: 8px;
      background: #fff;
      border-radius: 6px;
      font-size: 13px;
      color: #444;
    }
    .season-item img { width: 50px; height: 38px; object-fit: cover; border-radius: 4px; }

    /* 宿セクション */
    .hotel-section { margin-bottom: 40px; }
    .hotel-cards { display: flex; flex-direction: column; gap: 10px; }
    .hotel-card {
      display: flex; justify-content: space-between; align-items: center;
      padding: 18px 20px; border: 1px solid #e8e8e8; border-radius: 8px;
      text-decoration: none; box-shadow: 0 1px 4px rgba(0,0,0,0.04);
    }
    .hotel-card-rakuten { border-left: 4px solid #BF0000; }
    .hotel-card-jalan   { border-left: 4px solid #FF6B00; }
    .hotel-card-name { font-size: 14px; color: #1a1a1a; }
    .hotel-card-desc { font-size: 11px; color: #aaa; }
    .hotel-card-arrow { color: #ccc; }

    /* CTA */
    .cta {
      padding: 38px 24px;
      background: linear-gradient(135deg, #1e4d38 0%, #2A6049 100%);
      border-radius: 12px;
      text-align: center;
      color: #fff;
    }
    .cta-title { font-size: 18px; margin-bottom: 18px; font-family: 'Noto Serif JP', serif; font-weight: 300; }
    .cta-btn {
      display: inline-block; padding: 12px 28px;
      background: #fff; color: #2A6049;
      border-radius: 6px; font-size: 13px; text-decoration: none;
    }

    /* タブ別表示制御 */
    .tab-content { display: none; }
    .tab-content.active { display: block; }
  </style>

  <!-- Hero -->
  <div class="hub-hero">
    {hubImage
      ? <img class="hub-hero-img" src={hubImage} alt={hub.name} />
      : <div style="width:100%;height:100%;background:linear-gradient(160deg,#1a2e20,#2A6049);" />
    }
    <div class="hub-hero-overlay" />
    <div class="hub-hero-text">
      <p class="hub-hero-pref">{hub.prefecture} / {hub.region}</p>
      <h1 class="hub-hero-title">{hub.name}を拠点に旅する</h1>
      <p class="hub-hero-count">{hubDests.length}件の旅先</p>
    </div>
  </div>

  <div class="hub-body">

    <!-- Hub description -->
    <p class="hub-desc">{hub.desc}</p>

    <!-- Tabs: 日帰り/1泊/2泊以上 -->
    <div class="stay-tabs">
      <button class="stay-tab active" data-tab="daytrip">
        <span class="stay-tab-label">日帰り</span>
        <span class="stay-tab-count">{daytripDests.length}件</span>
      </button>
      <button class="stay-tab" data-tab="onenight">
        <span class="stay-tab-label">1泊</span>
        <span class="stay-tab-count">{oneNightDests.length}件</span>
      </button>
      <button class="stay-tab" data-tab="twonight">
        <span class="stay-tab-label">2泊以上</span>
        <span class="stay-tab-count">{twoNightDests.length}件</span>
      </button>
    </div>

    <!-- タブ内容: 日帰り -->
    <div class="tab-content active" data-tab-content="daytrip">
      <p class="section-eyebrow">Day Trip</p>
      <h2 class="section-title">日帰りで行ける旅先</h2>
      {daytripDests.length > 0 ? (
        <div class="h-scroll">
          {daytripDests.slice(0, 12).map((d: any) => {
            const img = destImageUrl(d);
            return (
              <a href={`/destinations/${d.id}/`} class="h-card">
                <div class="h-card-img-wrap">
                  {img && <img class="h-card-img" src={img} alt={d.name} loading="lazy" onerror="this.style.display='none'" />}
                </div>
                <div class="h-card-body">
                  <div class="h-card-name">{d.name}</div>
                  <div class="h-card-meta">{d.prefecture}</div>
                </div>
              </a>
            );
          })}
        </div>
      ) : <p style="color:#999;font-size:13px;">日帰り対象の旅先がまだ登録されていません。</p>}
    </div>

    <!-- タブ内容: 1泊 -->
    <div class="tab-content" data-tab-content="onenight">
      <p class="section-eyebrow">1 Night Stay</p>
      <h2 class="section-title">1泊でゆったり旅先</h2>
      <div class="h-scroll">
        {oneNightDests.slice(0, 12).map((d: any) => {
          const img = destImageUrl(d);
          return (
            <a href={`/destinations/${d.id}/`} class="h-card">
              <div class="h-card-img-wrap">
                {img && <img class="h-card-img" src={img} alt={d.name} loading="lazy" onerror="this.style.display='none'" />}
              </div>
              <div class="h-card-body">
                <div class="h-card-name">{d.name}</div>
                <div class="h-card-meta">{d.prefecture}</div>
              </div>
            </a>
          );
        })}
      </div>
    </div>

    <!-- タブ内容: 2泊以上 -->
    <div class="tab-content" data-tab-content="twonight">
      <p class="section-eyebrow">Long Stay</p>
      <h2 class="section-title">2泊以上で楽しむ旅先</h2>
      <div class="h-scroll">
        {twoNightDests.slice(0, 12).map((d: any) => {
          const img = destImageUrl(d);
          return (
            <a href={`/destinations/${d.id}/`} class="h-card">
              <div class="h-card-img-wrap">
                {img && <img class="h-card-img" src={img} alt={d.name} loading="lazy" onerror="this.style.display='none'" />}
              </div>
              <div class="h-card-body">
                <div class="h-card-name">{d.name}</div>
                <div class="h-card-meta">{d.prefecture}</div>
              </div>
            </a>
          );
        })}
      </div>
    </div>

    <!-- 距離ゾーン別 -->
    {(zone1.length > 0 || zone2.length > 0 || zone3.length > 0) && (
      <section class="section" style="margin-top:48px;">
        <p class="section-eyebrow">By Distance</p>
        <h2 class="section-title">所要時間で選ぶ</h2>

        {zone1.length > 0 && (
          <div style="margin-bottom:24px;">
            <h3 style="font-size:14px;color:#2A6049;margin-bottom:10px;">〜60分</h3>
            <div class="h-scroll">
              {zone1.slice(0, 8).map((d: any) => {
                const img = destImageUrl(d);
                return (
                  <a href={`/destinations/${d.id}/`} class="h-card">
                    <div class="h-card-img-wrap">{img && <img class="h-card-img" src={img} alt={d.name} loading="lazy" />}</div>
                    <div class="h-card-body"><div class="h-card-name">{d.name}</div></div>
                  </a>
                );
              })}
            </div>
          </div>
        )}
        {zone2.length > 0 && (
          <div style="margin-bottom:24px;">
            <h3 style="font-size:14px;color:#2A6049;margin-bottom:10px;">1〜2時間</h3>
            <div class="h-scroll">
              {zone2.slice(0, 8).map((d: any) => {
                const img = destImageUrl(d);
                return (
                  <a href={`/destinations/${d.id}/`} class="h-card">
                    <div class="h-card-img-wrap">{img && <img class="h-card-img" src={img} alt={d.name} loading="lazy" />}</div>
                    <div class="h-card-body"><div class="h-card-name">{d.name}</div></div>
                  </a>
                );
              })}
            </div>
          </div>
        )}
        {zone3.length > 0 && (
          <div>
            <h3 style="font-size:14px;color:#2A6049;margin-bottom:10px;">2〜3時間</h3>
            <div class="h-scroll">
              {zone3.slice(0, 8).map((d: any) => {
                const img = destImageUrl(d);
                return (
                  <a href={`/destinations/${d.id}/`} class="h-card">
                    <div class="h-card-img-wrap">{img && <img class="h-card-img" src={img} alt={d.name} loading="lazy" />}</div>
                    <div class="h-card-body"><div class="h-card-name">{d.name}</div></div>
                  </a>
                );
              })}
            </div>
          </div>
        )}
      </section>
    )}

    <!-- テーマ別 -->
    {themeSections.length > 0 && (
      <section class="section">
        <p class="section-eyebrow">By Theme</p>
        <h2 class="section-title">テーマで選ぶ</h2>
        {themeSections.map(t => (
          <div style="margin-bottom:28px;">
            <h3 style="font-size:14px;color:#444;margin-bottom:10px;">{t.emoji} {t.label}</h3>
            <div class="h-scroll">
              {t.dests.map((d: any) => {
                const img = destImageUrl(d);
                return (
                  <a href={`/destinations/${d.id}/`} class="h-card">
                    <div class="h-card-img-wrap">{img && <img class="h-card-img" src={img} alt={d.name} loading="lazy" />}</div>
                    <div class="h-card-body"><div class="h-card-name">{d.name}</div><div class="h-card-meta">{d.prefecture}</div></div>
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </section>
    )}

    <!-- 季節おすすめ -->
    {(seasonalDests.spring.length > 0 || seasonalDests.summer.length > 0 || seasonalDests.autumn.length > 0 || seasonalDests.winter.length > 0) && (
      <section class="section">
        <p class="section-eyebrow">By Season</p>
        <h2 class="section-title">季節で選ぶ</h2>
        <div class="season-grid">
          {(['spring','summer','autumn','winter'] as const).map(s => (
            seasonalDests[s].length > 0 && (
              <div class="season-block">
                <h3 class="season-title">{SEASON_LABEL[s]}のおすすめ</h3>
                <div class="season-list">
                  {seasonalDests[s].map((d: any) => {
                    const img = destImageUrl(d);
                    return (
                      <a href={`/destinations/${d.id}/`} class="season-item">
                        {img && <img src={img} alt={d.name} loading="lazy" />}
                        <span>{d.name}</span>
                      </a>
                    );
                  })}
                </div>
              </div>
            )
          ))}
        </div>
      </section>
    )}

    <!-- 宿リンク -->
    <section class="hotel-section">
      <p class="section-eyebrow">Stay</p>
      <h2 class="section-title">{hub.name}の宿を探す</h2>
      <div class="hotel-cards">
        <a href={rakutenUrl} target="_blank" rel="noopener noreferrer" class="hotel-card hotel-card-rakuten">
          <div>
            <p class="hotel-card-name">楽天トラベル</p>
            <p class="hotel-card-desc">ポイントが貯まる・使える</p>
          </div>
          <span class="hotel-card-arrow">→</span>
        </a>
        <a href={jalanUrl} target="_blank" rel="noopener noreferrer" class="hotel-card hotel-card-jalan">
          <div>
            <p class="hotel-card-name">じゃらん</p>
            <p class="hotel-card-desc">国内旅行・宿泊予約</p>
          </div>
          <span class="hotel-card-arrow">→</span>
        </a>
      </div>
    </section>

    <!-- CTA -->
    <div class="cta">
      <p class="cta-title">旅先を1分で決めてみる？</p>
      <a href="/" class="cta-btn">どこ行こ？で旅先を探す →</a>
    </div>

  </div>

  <script>
    const tabs = document.querySelectorAll<HTMLButtonElement>('.stay-tab');
    const contents = document.querySelectorAll<HTMLElement>('.tab-content');
    tabs.forEach(t => {
      t.addEventListener('click', () => {
        tabs.forEach(x => x.classList.remove('active'));
        contents.forEach(c => c.classList.remove('active'));
        t.classList.add('active');
        const key = t.dataset.tab;
        const c = document.querySelector(`[data-tab-content="${key}"]`);
        if (c) c.classList.add('active');
      });
    });
  </script>
</DestinationLayout>
