---
import DestinationLayout from '../layouts/DestinationLayout.astro';
import destinations from '../data/destinations.json';
import fs from 'fs';
import path from 'path';

const KYUSHU_PREFS = ['福岡県', '佐賀県', '長崎県', '熊本県', '大分県', '宮崎県', '鹿児島県'];

// 2026-08-31 に追加した秘湯・小規模温泉。「注目」枠で先に出す
const NEW_IDS = ['kannojigoku', 'yunohira-onsen', 'hagenoyu-onsen', 'yunotsuru-onsen',
  'tsuetate-onsen', 'funagoya-onsen', 'kumanokawa-onsen', 'furuyu-onsen', 'hinokage-onsen'];

const imgDir = path.join(process.cwd(), 'public/images');
function destImageUrl(d: any): string | null {
  if (fs.existsSync(path.join(imgDir, d.id, 'main.jpg'))) return `/images/${d.id}/main.jpg`;
  if (fs.existsSync(path.join(imgDir, `${d.id}.jpg`))) return `/images/${d.id}.jpg`;
  return null;
}

const kyushu = (destinations as any[]).filter(d => KYUSHU_PREFS.includes(d.prefecture));
const newDests = NEW_IDS.map(id => kyushu.find(d => d.id === id)).filter(Boolean);

// 県別グループ（新規は注目枠で出すので県別一覧では重複を避けず、通常どおり県の中にも置く）
const byPref = KYUSHU_PREFS.map(pref => ({
  pref,
  dests: kyushu.filter(d => d.prefecture === pref)
    .sort((a, b) => (b.weight ?? 1) - (a.weight ?? 1)),
})).filter(g => g.dests.length > 0);

// 泊まりたい宿（featured_stay があるものだけ）。新規の一軒宿を先頭に寄せる
const stays = kyushu.filter(d => d.featured_stay?.name)
  .sort((a, b) => (NEW_IDS.includes(b.id) ? 1 : 0) - (NEW_IDS.includes(a.id) ? 1 : 0));

const total = kyushu.length;
const title = '九州ふっこう割で行く旅先まとめ｜どこ行こ？';
const description = `九州7県の旅先${total}か所を県別に一覧。観光庁の「九州ふっこう応援割」は2026年10月1日の宿泊分から開始予定です。一軒宿の秘湯から定番の温泉地まで、泊まる場所から旅を決められるようにまとめました。`;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: 'https://tabidokoiko.com/kyushu-fukko/',
  about: { '@type': 'Place', name: '九州' },
});
---

<DestinationLayout title={title} description={description} image={null}>
  <script type="application/ld+json" set:html={jsonLd} slot="head-extra" />

  <style>
    .kf-hero {
      background: linear-gradient(135deg, #1e4d38 0%, #2A6049 100%);
      padding: 44px 24px 38px;
      color: #fff;
    }
    .kf-hero-inner { max-width: 680px; margin: 0 auto; }
    .kf-hero-eyebrow {
      font-size: 10px; letter-spacing: 0.22em; color: #C9A84C;
      text-transform: uppercase; margin-bottom: 10px;
    }
    .kf-hero-title {
      font-family: 'Noto Serif JP', serif; font-size: 26px; font-weight: 300;
      letter-spacing: 0.05em; line-height: 1.6; margin-bottom: 14px;
    }
    .kf-hero-lead { font-size: 13px; line-height: 2; color: rgba(255,255,255,0.88); }

    .kf-body { max-width: 680px; margin: 0 auto; padding: 28px 20px 60px; }

    /* 制度の説明（数字は書かず公式へ送る） */
    .kf-notice {
      padding: 20px 22px; background: #f8fdf9; border-left: 3px solid #2A6049;
      border-radius: 0 6px 6px 0; font-size: 13px; color: #444; line-height: 2;
      margin-bottom: 20px;
    }
    .kf-notice a { color: #2A6049; text-decoration: underline; text-underline-offset: 3px; }
    .kf-notice-links { margin-top: 12px; display: flex; flex-direction: column; gap: 6px; font-size: 12px; }

    /* 地震への注記 */
    .kf-caution {
      padding: 16px 18px; background: #fdf8f4; border-left: 3px solid #C08A4C;
      border-radius: 0 6px 6px 0; font-size: 12px; color: #5a4a3a; line-height: 1.95;
      margin-bottom: 36px;
    }

    .kf-section { margin: 0 0 46px; }
    .kf-eyebrow {
      font-size: 10px; letter-spacing: 0.22em; color: #9a7c36;
      text-transform: uppercase; display: block; margin-bottom: 6px;
    }
    .kf-title {
      font-family: 'Noto Serif JP', serif; font-size: 20px; font-weight: 400;
      color: #1a1a1a; letter-spacing: 0.04em; margin-bottom: 8px;
    }
    .kf-sub { font-size: 12px; color: #888; line-height: 1.9; margin-bottom: 18px; }

    /* 注目カード（縦積み・大きめ） */
    .kf-feature-list { display: flex; flex-direction: column; gap: 14px; }
    .kf-feature {
      display: block; text-decoration: none; border: 1px solid #e8e8e8;
      border-radius: 10px; overflow: hidden; background: #fff;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05); transition: transform 0.15s;
    }
    .kf-feature:hover { transform: translateY(-2px); }
    .kf-feature-img-wrap { position: relative; height: 168px; background: #eee; }
    .kf-feature-img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .kf-feature-badge {
      position: absolute; top: 10px; left: 10px; background: rgba(42,96,73,0.94);
      color: #fff; font-size: 10px; letter-spacing: 0.12em; padding: 4px 10px; border-radius: 3px;
    }
    .kf-feature-body { padding: 14px 16px 16px; }
    .kf-feature-name { font-size: 16px; color: #1a1a1a; font-weight: 500; margin-bottom: 2px; }
    .kf-feature-pref { font-size: 11px; color: #999; letter-spacing: 0.06em; margin-bottom: 8px; }
    .kf-feature-catch { font-size: 13px; color: #555; line-height: 1.85; }
    .kf-feature-stay { font-size: 11px; color: #9a7c36; margin-top: 8px; }

    /* 県別グリッド */
    .kf-pref { margin-bottom: 30px; }
    .kf-pref-name {
      font-family: 'Noto Serif JP', serif; font-size: 15px; color: #2A6049;
      letter-spacing: 0.08em; margin-bottom: 10px;
      padding-bottom: 6px; border-bottom: 1px solid #e8e8e8;
      display: flex; justify-content: space-between; align-items: baseline;
    }
    .kf-pref-count { font-size: 11px; color: #bbb; letter-spacing: 0.04em; }
    .kf-chips { display: flex; flex-wrap: wrap; gap: 7px; }
    .kf-chip {
      display: inline-block; padding: 7px 12px; border: 1px solid #e2e2e2;
      border-radius: 16px; font-size: 12.5px; color: #444; text-decoration: none;
      background: #fff; transition: all 0.13s; line-height: 1.5;
    }
    .kf-chip:hover { border-color: #2A6049; color: #2A6049; }
    .kf-chip-new { border-color: #C9A84C; background: #fffdf5; color: #7a6220; }

    /* 宿リスト */
    .kf-stays { display: flex; flex-direction: column; gap: 9px; }
    .kf-stay {
      display: flex; gap: 12px; align-items: center; text-decoration: none;
      padding: 12px 14px; border: 1px solid #eee; border-radius: 8px; background: #fff;
    }
    .kf-stay:hover { border-color: #d8d8d8; }
    .kf-stay img { width: 62px; height: 48px; object-fit: cover; border-radius: 5px; flex: 0 0 62px; }
    .kf-stay-ph { width: 62px; height: 48px; border-radius: 5px; background: #f2f2f2; flex: 0 0 62px; }
    .kf-stay-body { min-width: 0; }
    .kf-stay-name { font-size: 13.5px; color: #1a1a1a; margin-bottom: 2px; }
    .kf-stay-where { font-size: 11px; color: #999; }
    .kf-stay-copy {
      font-size: 11.5px; color: #777; margin-top: 3px; line-height: 1.7;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }

    .kf-more { display: block; text-align: right; font-size: 12px; color: #2A6049; margin-top: 12px; letter-spacing: 0.05em; }
  </style>

  <section class="kf-hero">
    <div class="kf-hero-inner">
      <p class="kf-hero-eyebrow">KYUSHU</p>
      <h1 class="kf-hero-title">九州ふっこう割で行く、<br>まだ知らない九州</h1>
      <p class="kf-hero-lead">
        名前を聞いたことのある温泉地の、少し奥。宿が数軒しかない谷や、冷たい湯に入る一軒宿が九州にはまだ残っています。
        七県{total}か所を県別にまとめました。
      </p>
    </div>
  </section>

  <div class="kf-body">
    <div class="kf-notice">
      観光庁は九州の観光需要の回復に向けて「<strong>九州ふっこう応援割</strong>」を実施します。対象は九州7県での宿泊を伴う旅行で、
      2026年10月1日の宿泊分からの開始が発表されています。
      <strong>割引率・上限額・予約開始日・対象施設は県ごとに決まり、変更されることがあります。</strong>
      最新の条件は必ず公式の発表でご確認ください。
      <div class="kf-notice-links">
        <a href="/ouen-wari/">県ごとの予約開始日・対象期間はこちら（旅行支援・応援割まとめ）→</a>
        <a href="https://www.mlit.go.jp/kankocho/topics04_00093.html" target="_blank" rel="noopener">観光庁「令和8年熊本地震 関連情報（九州ふっこう応援割について掲載）」→</a>
        <a href="https://www.welcomekyushu.jp/" target="_blank" rel="noopener">九州観光機構「九州旅ネット」→</a>
      </div>
    </div>

    <div class="kf-caution">
      2026年7月28日の令和8年熊本地震により、九州の一部では復旧作業が続いています。
      八代市の日奈久温泉のように源泉の配管が損傷し、多くの宿が休業している温泉地もあります。
      このページでは営業を確認できた旅先を掲載していますが、状況は日々変わります。
      出発前に各施設・自治体の最新情報をご確認ください。
    </div>

    <section class="kf-section">
      <span class="kf-eyebrow">Newly added</span>
      <h2 class="kf-title">注目：宿が数軒しかない温泉</h2>
      <p class="kf-sub">
        今回あらたに調べて追加した{newDests.length}か所です。大手の旅行サイトのトップページには、まず出てきません。
        座標と写真は複数の情報源で照合し、営業していることを一軒ずつ確認しています。
      </p>
      <div class="kf-feature-list">
        {newDests.map((d: any) => {
          const img = destImageUrl(d);
          return (
            <a class="kf-feature" href={`/destinations/${d.id}/`}>
              {img && (
                <div class="kf-feature-img-wrap">
                  <img class="kf-feature-img" src={img} alt={`${d.name}の${d.mainSpot ?? '風景'}`} loading="lazy" />
                  <span class="kf-feature-badge">注目</span>
                </div>
              )}
              <div class="kf-feature-body">
                <p class="kf-feature-name">{d.name}</p>
                <p class="kf-feature-pref">{d.prefecture}{d.city ? ` ${d.city}` : ''}</p>
                <p class="kf-feature-catch">{d.catch}</p>
                {d.featured_stay?.name && <p class="kf-feature-stay">泊まる：{d.featured_stay.name}</p>}
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <section class="kf-section">
      <span class="kf-eyebrow">By prefecture</span>
      <h2 class="kf-title">県別に見る</h2>
      <p class="kf-sub">金色のものが今回追加した旅先です。</p>
      {byPref.map(g => (
        <div class="kf-pref">
          <p class="kf-pref-name">
            <span>{g.pref}</span>
            <span class="kf-pref-count">{g.dests.length}か所</span>
          </p>
          <div class="kf-chips">
            {g.dests.map((d: any) => (
              <a class={`kf-chip${NEW_IDS.includes(d.id) ? ' kf-chip-new' : ''}`} href={`/destinations/${d.id}/`}>{d.name}</a>
            ))}
          </div>
        </div>
      ))}
    </section>

    <section class="kf-section">
      <span class="kf-eyebrow">Where to stay</span>
      <h2 class="kf-title">泊まりたい宿</h2>
      <p class="kf-sub">
        その宿に泊まること自体が目的になる場所を選びました。予約や料金は各予約サイトでご確認ください。
      </p>
      <div class="kf-stays">
        {stays.slice(0, 24).map((d: any) => {
          const img = destImageUrl(d);
          return (
            <a class="kf-stay" href={`/destinations/${d.id}/`}>
              {img ? <img src={img} alt={`${d.name}の風景`} loading="lazy" /> : <span class="kf-stay-ph" />}
              <span class="kf-stay-body">
                <span class="kf-stay-name">{d.featured_stay.name}</span>
                <span class="kf-stay-where">{d.prefecture}・{d.name}</span>
                {d.featured_stay.catchcopy && <span class="kf-stay-copy">{d.featured_stay.catchcopy}</span>}
              </span>
            </a>
          );
        })}
      </div>
      {stays.length > 24 && <a class="kf-more" href="/list/">九州の宿をもっと見る →</a>}
    </section>

    <section class="kf-section">
      <span class="kf-eyebrow">More</span>
      <h2 class="kf-title">ほかの探し方</h2>
      <div class="kf-chips">
        <a class="kf-chip" href="/ouen-wari/">旅行支援・応援割まとめ</a>
        <a class="kf-chip" href="/destinations/">目的地一覧</a>
        <a class="kf-chip" href="/list/">全国一覧</a>
        <a class="kf-chip" href="/hub/fukuoka/">福岡を拠点に探す</a>
        <a class="kf-chip" href="/hub/kagoshima/">鹿児島を拠点に探す</a>
      </div>
    </section>
  </div>
</DestinationLayout>
