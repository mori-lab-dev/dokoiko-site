---
import StaticPageLayout from '../layouts/StaticPageLayout.astro';
// 宛先は直接の mailto リンクで出す（難読化・JS 組み立ては使わない）。
const MAIL = 'morilab.support@gmail.com';
const TYPES = [
  { key: 'error', label: '誤りの指摘', subject: '【どこ行こ？】誤りの指摘' },
  { key: 'opinion', label: 'ご意見', subject: '【どこ行こ？】ご意見' },
  { key: 'removal', label: '掲載の削除依頼', subject: '【どこ行こ？】掲載の削除依頼' },
].map((t) => ({
  ...t,
  href: `mailto:${MAIL}?subject=${encodeURIComponent(t.subject)}&body=${encodeURIComponent(`対象ページ: （分かればURLをお書きください）\n種別: ${t.label}\n\n（ここに内容をお書きください）\n`)}`,
}));
---

<StaticPageLayout
  title="お問い合わせ｜どこ行こ？"
  description="「どこ行こ？」へのお問い合わせ窓口です。掲載内容の誤りのご指摘、掲載依頼・削除依頼、その他のご連絡はメールでお受けしています。"
  eyebrow="Contact"
  heading="お問い合わせ"
>
  <p class="sp-note">
    個人運営のため、返信に数日かかる場合があります。<br>
    受け付けているのは、<strong>誤りの指摘</strong>・<strong>ご意見</strong>・<strong>掲載の削除依頼</strong>です。
  </p>

  <h2>メールで知らせる</h2>
  <p>宛先は <a href={`mailto:${MAIL}`}>{MAIL}</a> です。種類のリンクを押すと、メールアプリが開きます。件名と本文の書き出しは自動で入るので、内容を書き足して送ってください。該当ページのURLもお書き添えください。</p>
  <ul class="ct-types">
    {TYPES.map((t) => (
      <li><a class="ct-mail" data-type={t.key} href={t.href}>{t.label}</a></li>
    ))}
  </ul>
  <p class="ct-page" id="ct-page" hidden>対象ページ: <span id="ct-page-url"></span></p>
  <style>
    .ct-types { padding-left: 1.2em; }
    .ct-types li { line-height: 2.2; font-size: 14px; }
    .ct-page { font-size: 12px !important; color: #666 !important; word-break: break-all; line-height: 1.7 !important; }
  </style>
  <script is:inline>
    (function () {
      // 「この情報の誤りを知らせる」から来たとき、対象ページを本文に入れる（当サイトのURLだけ）
      var q = new URLSearchParams(location.search);
      var page = q.get('page') || '';
      if (!/^https:\/\/tabidokoiko\.com\/[A-Za-z0-9\-._~%\/]*$/.test(page) || page.length > 300) return;
      document.getElementById('ct-page-url').textContent = page;
      document.getElementById('ct-page').hidden = false;
      var links = document.querySelectorAll('a.ct-mail');
      for (var i = 0; i < links.length; i++) {
        links[i].href = links[i].href.replace(encodeURIComponent('対象ページ: （分かればURLをお書きください）'), encodeURIComponent('対象ページ: ' + page));
      }
      var t = q.get('type');
      var hit = t && document.querySelector('a.ct-mail[data-type="' + t + '"]');
      if (hit) hit.style.fontWeight = 'bold';
    })();
  </script>

  <h2>X（旧Twitter）</h2>
  <p>
    更新のお知らせは <a href="https://x.com/mori__lab" target="_blank" rel="noopener">@mori__lab</a> で流しています。
    軽いご連絡はこちらでも受け付けています。掲載内容の修正や削除のご依頼など、
    記録が残ったほうがよいものはメールでお願いします。
  </p>

  <h2>よくいただくご連絡</h2>

  <h3>掲載内容の誤りについて</h3>
  <p>
    掲載している営業時間・料金・アクセス・営業状況などは、公式サイトや自治体・観光協会の情報をもとに
    作成していますが、時間の経過で実態と合わなくなることがあります。
    お気づきの点があれば、該当ページのURLとあわせてお知らせいただけると助かります。
    確認のうえ、修正または掲載の取り下げを行います。
  </p>

  <h3>施設・観光事業者の方へ</h3>
  <p>
    掲載内容の修正、写真の差し替え、掲載の停止についてもメールで承ります。
    施設名とご連絡先を添えてご連絡ください。掲載停止のご依頼は、内容の是非を問わず対応します。
  </p>

  <h3>写真の権利について</h3>
  <p>
    掲載写真は原則としてウィキメディア・コモンズのライセンス表示に従って利用しています。
    権利関係でお心当たりのある方は、対象の写真が使われているページのURLを添えてご連絡ください。
  </p>

  <h2>お答えできないこと</h2>
  <ul>
    <li>宿泊・交通機関の予約、変更、キャンセルの取り次ぎ</li>
    <li>個別の旅程作成やお見積もり</li>
    <li>掲載施設へのお問い合わせの代行</li>
  </ul>
  <p>
    予約に関することは、各予約サイトまたは施設へ直接お問い合わせください。
  </p>
</StaticPageLayout>
