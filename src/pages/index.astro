<script>
import { buildShuffledPool } from '../scripts/selectionEngine.js';
import { DEPARTURES, DEPARTURE_GROUPS, DEPARTURE_CITY_INFO, DEPARTURE_COORDS } from '../scripts/dokoikoConstants.js';
import { calculateTravelTimeMinutes } from '../scripts/distanceCalculator.js';

declare function gtag(...args: any[]): void;

const state = {
  destinations: [] as any[],
  departure: '東京',
  stayType: '1night',
  theme: null as string | null,
  pool: [] as any[],
  poolIndex: 0,
};

const sel = document.getElementById('departure-select') as HTMLSelectElement;
DEPARTURE_GROUPS.forEach(group => {
  const og = document.createElement('optgroup');
  og.label = group.label;
  group.cities.forEach(city => {
    const opt = document.createElement('option');
    opt.value = city;
    opt.textContent = city;
    og.appendChild(opt);
  });
  sel.appendChild(og);
});

const savedDep = localStorage.getItem('departure');
if (savedDep && DEPARTURES.includes(savedDep)) {
  state.departure = savedDep;
  sel.value = savedDep;
} else {
  sel.value = '東京';
}

(async function init() {
  const params = new URLSearchParams(location.search);
  const fromParam   = params.get('from');
  const nightsParam = params.get('nights');
  const themeParam  = params.get('theme');
  const destParam   = params.get('dest');
  const regionParam = params.get('region');

  if (fromParam && DEPARTURES.includes(fromParam)) {
    state.departure = fromParam;
    sel.value = fromParam;
  }
  if (nightsParam) {
    state.stayType = nightsParam;
    document.querySelectorAll<HTMLButtonElement>('[data-stay]').forEach(b => {
      b.classList.toggle('active', b.dataset.stay === nightsParam);
    });
  }
  if (themeParam !== null) {
    state.theme = themeParam || null;
    document.querySelectorAll<HTMLButtonElement>('[data-theme]').forEach(b => {
      b.classList.toggle('active', (b.dataset.theme || null) === state.theme);
    });
  }

  try {
    const res = await fetch('/data/destinations.json');
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    state.destinations = await res.json();

    if (destParam) {
      buildPool();
      const idx = state.pool.findIndex(d => d.id === destParam);
      if (idx !== -1) {
        state.poolIndex = idx;
      } else {
        const found = state.destinations.find(d => d.id === destParam);
        if (found) { state.pool.unshift(found); state.poolIndex = 0; }
      }
      if (state.pool.length) showResult(state.pool[state.poolIndex]);
    } else if (regionParam !== null) {
      applyFilter(regionParam);
      document.getElementById('map')?.scrollIntoView({ behavior: 'auto' });
    } else if (fromParam || nightsParam || themeParam) {
      go();
    }
  } catch (err) {
    console.error('[init]', err);
    const goBtn = document.getElementById('go-btn') as HTMLButtonElement;
    goBtn.textContent = 'データ読み込み失敗';
    goBtn.disabled = true;
  }
})();

function buildPool() {
  const info = DEPARTURE_CITY_INFO[state.departure];
  const hub = info?.nearestHub ?? null;
  state.pool = buildShuffledPool(
    state.destinations, state.stayType, state.theme,
    state.departure, hub, false, null
  );
  state.poolIndex = 0;
}

function go() {
  if (!state.destinations.length) return;
  const goBtn = document.getElementById('go-btn') as HTMLButtonElement;
  const errEl = document.getElementById('form-error')!;
  goBtn.textContent = '探しています…';
  goBtn.disabled = true;

  requestAnimationFrame(() => setTimeout(() => {
    buildPool();
    if (!state.pool.length) {
      errEl.textContent = '条件に合う旅先が見つかりませんでした。条件を変えてお試しください。';
      errEl.hidden = false;
      goBtn.textContent = 'どこ行こ？';
      goBtn.disabled = false;
      return;
    }
    errEl.hidden = true;
    showResult(state.pool[0]);
    goBtn.textContent = 'もう一度探す';
    goBtn.disabled = false;
    encodeUrl();
    document.getElementById('result')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }, 180));
}

function retry() {
  state.poolIndex += 3;
  if (state.poolIndex >= state.pool.length) buildPool();
  showResults();
  encodeUrl();
  document.getElementById('result')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function encodeUrl() {
  const p = new URLSearchParams();
  p.set('from', state.departure);
  p.set('nights', state.stayType);
  if (state.theme) p.set('theme', state.theme);
  const city = state.pool[state.poolIndex];
  if (city) p.set('dest', city.id);
  history.replaceState(null, '', '?' + p.toString());
}

function formatTime(minutes: number): string | null {
  if (!minutes || minutes >= 700) return null;
  if (minutes < 60) return `約${minutes}分`;
  const h = Math.floor(minutes / 60);
  const m = minutes % 60;
  return m > 0 ? `約${h}時間${m}分` : `約${h}時間`;
}

function showResults() {
  const cities = state.pool.slice(state.poolIndex, state.poolIndex + 3);
  if (!cities.length) return;

  const stayLabel: Record<string, string> = { daytrip: '日帰り', '1night': '1泊', '2night': '2泊以上' };
  const condParts = [state.departure, stayLabel[state.stayType] ?? state.stayType, ...(state.theme ? [state.theme] : [])];
  const condSummary = condParts.join(' / ');

  const cards = cities.map((city: any) => {
    const name = city.displayName || city.name;
    const allTags: string[] = city.primary?.length
      ? [...(city.primary ?? []), ...(city.secondary ?? [])]
      : (city.tags ?? []);
    const imgSrc = (city.images && city.images[0]) || city.unsplashUrl || '/images/' + city.id + '/main.jpg';
    const imgFallback = city.unsplashUrl || '/images/' + city.id + '.jpg';
    const tagHtml = allTags.slice(0, 2).map((t: string) => `<span class="rc-card-tag">${t}</span>`).join('');
    return `
      <a href="/destinations/${city.id}/" class="rc-card">
        <div class="rc-card-img-wrap">
          <img class="rc-card-img"
            src="${imgSrc}"
            alt="${name}の風景"
            onerror="this.onerror=null;this.src='${imgFallback}'"
            loading="lazy" />
          <div class="rc-card-overlay">
            ${tagHtml ? `<div class="rc-card-tags-wrap">${tagHtml}</div>` : ''}
            <h2 class="rc-card-name">${name}</h2>
            <p class="rc-card-pref">${city.prefecture || ''}</p>
          </div>
        </div>
      </a>`;
  }).join('');

  const inner = document.getElementById('result-inner')!;
  inner.innerHTML = `
    <p class="rc-condition">${condSummary}</p>
    <div class="rc-cards">${cards}</div>
  `;

  document.getElementById('result')!.hidden = false;

  const remaining = Math.max(0, state.pool.length - state.poolIndex - cities.length);
  document.getElementById('retry-btn')!.textContent = remaining > 0
    ? `別の旅先を見る（あと${remaining}件）`
    : 'もう一度探す';

  if (typeof gtag === 'function') {
    cities.forEach((city: any) => gtag('event', 'view_destination', { departure: state.departure, destination: city.id }));
  }
}

function showResult(city: any) {
  showResults();
}

document.addEventListener('click', (e) => {
  const t = e.target as Element;

  const stayBtn = t.closest<HTMLButtonElement>('[data-stay]');
  if (stayBtn) {
    state.stayType = stayBtn.dataset.stay!;
    document.querySelectorAll('[data-stay]').forEach(b => b.classList.remove('active'));
    stayBtn.classList.add('active');
    if (!document.getElementById('result')?.hidden) go();
    return;
  }

  const themeBtn = t.closest<HTMLButtonElement>('[data-theme]');
  if (themeBtn) {
    state.theme = themeBtn.dataset.theme || null;
    document.querySelectorAll('[data-theme]').forEach(b => b.classList.remove('active'));
    themeBtn.classList.add('active');
    if (!document.getElementById('result')?.hidden) go();
    return;
  }

  if (t.closest('#go-btn')) { go(); return; }
  if (t.closest('#retry-btn')) { retry(); return; }
});

sel?.addEventListener('change', (e) => {
  state.departure = (e.target as HTMLSelectElement).value;
  localStorage.setItem('departure', state.departure);
  if (!document.getElementById('result')?.hidden) go();
});

function nearestCity(lat: number, lng: number): string {
  let best = '東京', bestDist = Infinity;
  for (const [city, coord] of Object.entries(DEPARTURE_COORDS)) {
    const d = Math.hypot(lat - coord.lat, lng - coord.lng);
    if (d < bestDist) { bestDist = d; best = city; }
  }
  return best;
}

document.getElementById('location-btn')?.addEventListener('click', () => {
  const btn = document.getElementById('location-btn') as HTMLButtonElement;
  if (!navigator.geolocation) return;
  btn.textContent = '取得中…';
  btn.disabled = true;
  navigator.geolocation.getCurrentPosition(
    (pos) => {
      const city = nearestCity(pos.coords.latitude, pos.coords.longitude);
      state.departure = city;
      sel.value = city;
      localStorage.setItem('departure', city);
      btn.textContent = '現在地';
      btn.disabled = false;
    },
    () => { btn.textContent = '現在地'; btn.disabled = false; },
    { timeout: 8000, maximumAge: 60000 }
  );
});

const slides = document.querySelectorAll<HTMLElement>('.hero-slide');
if (slides.length > 1) {
  let cur = 0;
  setInterval(() => {
    slides[cur].classList.remove('is-active');
    cur = (cur + 1) % slides.length;
    slides[cur].classList.add('is-active');
  }, 5000);
}

// ── 地域フィルター & 目的地カード ──────────────────────────────────
const filterBtns  = document.querySelectorAll<HTMLButtonElement>('.region-btn');
const regionGs    = document.querySelectorAll<SVGGElement>('.jp-region');
const destPanel   = document.getElementById('dest-panel')!;
const allSection  = document.getElementById('all-section')!;
const allCards    = document.getElementById('all-cards')!;
const allMore     = document.getElementById('all-more')!;
const areaCards   = document.getElementById('area-cards')!;
const spotCards   = document.getElementById('spot-cards')!;
const areaSection = document.getElementById('area-section')!;
const spotSection = document.getElementById('spot-section')!;
const areaCount   = document.getElementById('area-count')!;
const spotCount   = document.getElementById('spot-count')!;
const areaMore    = document.getElementById('area-more')!;
const spotMore    = document.getElementById('spot-more')!;

const CARD_LIMIT = 12;
let activeRegion = '';

const mapDataPromise: Promise<any[]> = (async () => {
  if (state.destinations.length) return state.destinations;
  const r = await fetch('/data/destinations.json');
  return r.json();
})();

function makeCardHtml(d: any): string {
  return (
    `<a href="/destinations/${d.id}/" class="dest-card">` +
    `<div class="dest-card-img-wrap">` +
    `<img class="dest-card-bg" src="/images/${d.id}/main.jpg" alt="${d.name}" loading="lazy"` +
    ` onerror="if(!this.dataset.f){this.dataset.f='1';this.src='/images/${d.id}.jpg'}else{this.parentElement.classList.add('no-img');this.remove()}">` +
    `</div>` +
    `<div class="dest-card-body">` +
    `<div class="dest-card-name">${d.name}</div>` +
    `<div class="dest-card-pref">${d.prefecture || ''}</div>` +
    `</div>` +
    `</a>`
  );
}

function showSection(
  items: any[], cardsEl: HTMLElement, moreEl: HTMLElement,
  sectionEl: HTMLElement, countEl: HTMLElement
) {
  if (!items.length) { sectionEl.style.display = 'none'; return; }
  sectionEl.style.display = '';
  countEl.textContent = `（${items.length}件）`;
  const shown = items.slice(0, CARD_LIMIT);
  cardsEl.innerHTML = shown.map(makeCardHtml).join('');
  const rest = items.length - CARD_LIMIT;
  if (rest > 0) {
    moreEl.innerHTML =
      `<button class="more-btn" data-all="${encodeURIComponent(JSON.stringify(items.map((d:any)=>d.id)))}">` +
      `もっと見る（あと${rest}件）</button>`;
  } else {
    moreEl.innerHTML = '';
  }
}

async function renderRegionCards(region: string) {
  try {
    const allDests = await mapDataPromise;

    if (!region) {
      // すべて: 全地域からランダム12件
      const shuffled = [...allDests].sort(() => Math.random() - 0.5).slice(0, 12);
      allSection.style.display = '';
      allCards.innerHTML = shuffled.map(makeCardHtml).join('');
      allMore.innerHTML = '';
      areaSection.style.display = 'none';
      spotSection.style.display = 'none';
      destPanel.hidden = false;
      return;
    }

    allSection.style.display = 'none';
    const dests = allDests.filter((d: any) => d.region === region);

    const AREA_TYPES = new Set(['city', 'onsen']);
    const area = dests.filter((d: any) =>
      d.tier === 'area' || (!d.tier && AREA_TYPES.has(d.destType))
    );
    const spot = dests.filter((d: any) =>
      d.tier === 'spot' || (!d.tier && !AREA_TYPES.has(d.destType))
    );

    showSection(area, areaCards, areaMore, areaSection, areaCount);
    showSection(spot, spotCards, spotMore, spotSection, spotCount);
    destPanel.hidden = false;
  } catch (e) {
    console.error('[map filter]', e);
  }
}

document.addEventListener('click', (e) => {
  const btn = (e.target as Element).closest<HTMLButtonElement>('.more-btn');
  if (!btn) return;
  const allIds: string[] = JSON.parse(decodeURIComponent(btn.dataset.all || '[]'));
  const moreEl = btn.parentElement!;
  const cardsEl = moreEl.previousElementSibling as HTMLElement;
  mapDataPromise.then(allDests => {
    const ordered = allIds.map(id => allDests.find((d:any)=>d.id===id)).filter(Boolean);
    cardsEl.innerHTML = ordered.map(makeCardHtml).join('');
    moreEl.innerHTML = '';
  });
});

function applyFilter(region: string) {
  activeRegion = region;
  filterBtns.forEach(b =>
    b.classList.toggle('is-active', (b.dataset.region ?? '') === region)
  );
  if (!region) {
    regionGs.forEach(g => g.classList.remove('is-highlight', 'is-dim'));
  } else {
    regionGs.forEach(g => {
      const match = g.dataset.region === region;
      g.classList.toggle('is-highlight', match);
      g.classList.toggle('is-dim', !match);
    });
  }
  renderRegionCards(region);
}

filterBtns.forEach(btn =>
  btn.addEventListener('click', () => applyFilter(btn.dataset.region ?? ''))
);

regionGs.forEach(g =>
  g.addEventListener('click', () => {
    const r = g.dataset.region ?? '';
    applyFilter(activeRegion === r ? '' : r);
  })
);

applyFilter('');
</script>

</DestinationLayout>
