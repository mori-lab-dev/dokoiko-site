---
/**
 * 統合した旧ページの転送ページ（同名ページの統合・2026-11-09）。kumano.astro と同じ作り。
 * GitHub Pages は 301 を返せないので、canonical（評価の集約先）＋ meta refresh 0 ＋ location.replace ＋ 本文のリンクで送る。
 * noindex は入れない（入れると Google が URL を評価ごと落とす）。sitemap には載せない（sitemap は destinations.json から作るため、
 * データから消えた id は自動で載らない）。検査は scripts/auditMergedPages.mjs。
 */
interface Props { fromName: string; toId: string; toName: string; toHash?: string; moved?: boolean; }
const { fromName, toId, toName, toHash, moved } = Astro.props;
// moved: 内容が場所と合わなかったページを外し、近くの旅先へ移した転送ページ（2026-11-19）。「統合」とは書かない。
// toHash: 統合ページの見出しのid（元のページ id）。あれば、その見出しの位置（アンカー）へ飛ばす（2026-11-18）。canonical は #なし（評価の集約先はページ）。
const TO = `/destinations/${toId}/`;
const GO = toHash ? `${TO}#${toHash}` : TO;
const ABS = `https://tabidokoiko.com/destinations/${encodeURIComponent(toId)}/`;   // canonical・og:url は、転送先ページ自身の canonical と同じ（パーセントエンコード）形にする（日本語の id）
const LEAD = toHash ? `近い場所の「${fromName}」のページは、` : `同名の「${fromName}」のページは、`;   // meta description 用（読点つき）
const BODY_LEAD = toHash ? LEAD : `同名の「${fromName}」のページは`;   // 本文用。同名の統合の転送ページ（2026-11-09）は読点なしの元の文言のまま
const DESC = moved ? `「${fromName}」のページは、内容が場所と合わなかったため、近くの${toName}のページへ移しました。` : `${LEAD}${toName}のページに統合しました。`;
const TITLE = moved ? `「${fromName}」は「${toName}」へ移しました｜どこ行こ？` : `「${fromName}」は「${toName}」に統合しました｜どこ行こ？`;
---
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <link rel="canonical" href={ABS} />
    <meta http-equiv="refresh" content={`0; url=${GO}`} />
    <meta name="description" content={DESC} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ABS} />
    <meta property="og:title" content={`${toName}｜どこ行こ？`} />
    <meta property="og:description" content={DESC} />
    <meta property="og:image" content="https://tabidokoiko.com/images/share_default.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://tabidokoiko.com/images/share_default.jpg" />
    <style>
      body { font-family: system-ui, sans-serif; margin: 0; padding: 60px 24px; background: #faf9f7; color: #333; text-align: center; line-height: 2; }
      a { color: #2A6049; }
    </style>
  </head>
  <body>
    {moved ? <p>「{fromName}」のページは、内容が場所と合わなかったため、近くの<strong>{toName}</strong>のページへ移しました。</p> : <p>{BODY_LEAD}<strong>{toName}</strong>のページに統合しました。</p>}
    <p><a href={GO}>{toName}のページへ移動する →</a></p>
    <script is:inline define:vars={{ GO }}>
      location.replace(GO);
    </script>
  </body>
</html>
