---
// 診断の結果ページ /quiz/r/<code>/（2026-11-18）。共有（X）から来た人に、結果の画像・旅先・診断への入口を見せるだけの軽いページ。全旅先ぶん静的に作る。
// ・robots は noindex,follow。canonical は /quiz/。sitemap には入れない（src/pages/sitemap.xml.ts は触っていない）。
// ・中身: 共有画像・旅先名・県名・tags（最大3つ）・旅先ページへのリンク・「あなたも診断する」・作った人のXのリンク。所要時間・料金・送迎・「無料」は書かない。
// ・共通レイアウトは使わない（1枚あたりのHTMLを小さくして、配信物を増やしすぎないため。1,191ページぶん）。GA4 は既存のタグ。
import data from '../../../data/quizDestinations.json';
export function getStaticPaths() {
  return (data as any[]).map((d) => ({ params: { code: d.code }, props: { d } }));
}
const { d } = Astro.props as { d: any };
const SITE = 'https://tabidokoiko.com';
const label = `${d.name}（${d.prefecture}）`;
const title = `私に似合う旅先は【${d.name}(${d.prefecture})】｜旅先診断｜どこ行こ？`;
const description = `旅先診断の結果は${label}でした。12の質問に答えると、回答の傾向から旅先を1つ選びます。`;
const img = `${SITE}/quiz/og/${d.code}.png`;
const url = `${SITE}/quiz/r/${d.code}/`;
---
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content="noindex,follow">
<link rel="canonical" href={`${SITE}/quiz/`}>
<meta property="og:type" content="website">
<meta property="og:url" content={url}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={img}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="675">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={img}>
<script async src="https://www.googletagmanager.com/gtag/js?id=G-WCJKVC2DXY"></script>
<script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-WCJKVC2DXY');</script>
<style>
body{margin:0;font-family:'Noto Sans JP','Hiragino Sans',sans-serif;background:#f6f1e4;color:#25231f;line-height:1.8}
main{max-width:640px;margin:0 auto;padding:24px 18px 48px}
img{display:block;width:100%;height:auto;border-radius:10px;border:1px solid #e2d8bd}
h1{font-family:'Noto Serif JP',serif;font-weight:700;font-size:28px;line-height:1.4;margin:20px 0 2px}
.pref{margin:0 0 10px;color:#4a463d}
ul{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 18px;padding:0;list-style:none}
li{font-size:12px;padding:2px 10px;border-radius:999px;background:#ece3cb;color:#5b4f33}
.btn{display:block;box-sizing:border-box;width:100%;min-height:52px;padding:13px 16px;margin:0 0 10px;border-radius:10px;text-align:center;text-decoration:none;font-size:15px}
.go{background:#2A6049;color:#fff}.quiz{background:#fff;color:#2A6049;border:1px solid #2A6049}
.author{margin:26px 0 0;text-align:center;font-size:12px}.author a{color:#7d745f}
</style>
</head>
<body data-page-type="quiz-result" data-page-id={d.code}>
<main>
<img src={`/quiz/og/${d.code}.png`} width="1200" height="675" alt={`旅先診断の結果: ${label}`}>
<h1>{d.name}</h1>
<p class="pref">{d.prefecture}</p>
<ul>{d.tags.slice(0, 3).map((t: string) => <li>{t}</li>)}</ul>
<a class="btn go" href={d.url}>この旅先のページを見る</a>
<a class="btn quiz" href="/quiz/">あなたも診断する</a>
<p class="author"><a href="https://x.com/mori__lab" rel="noopener" target="_blank" id="author">作った人のX</a></p>
</main>
<script is:inline>document.getElementById('author').addEventListener('click',function(){try{gtag('event','author_x_click',{place:'result_page'})}catch(e){}});</script>
</body>
</html>
